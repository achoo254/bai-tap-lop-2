---
import '@fontsource-variable/nunito';
import '../styles/design-tokens.css';
import '../styles/lesson-content.css';
import '../styles/global.css';
import MascotKitten from '../components/mascot-kitten.astro';
import ReadingPreferencesToolbar from '../components/reading-preferences-toolbar.astro';
import ImageZoomDialog from '../components/image-zoom-dialog.astro';
import PwaInstallButton from '../components/pwa-install-button.astro';
import CompanionBuddy from '../components/companion/companion-buddy.astro';
import { hasHandwritingFont } from '../lib/handwriting-font';
import { FAMILY_FOOTER, SITE_TITLE } from '../lib/family-messages';

interface Props {
  title: string;
  /** Trang xem trước bài nháp không được lập chỉ mục. */
  noindex?: boolean;
  showToolbar?: boolean;
  /** Ngữ cảnh cho nhân vật đồng hành khi đường dẫn không đủ để biết (404, ngoại tuyến). */
  companionContext?: string;
}
const { title, noindex = false, showToolbar = true, companionContext } = Astro.props;
const handwritingAvailable = hasHandwritingFont();
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ff9fc0" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Miu học bài" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title} · {SITE_TITLE}</title>
    <script is:inline define:vars={{ handwritingAvailable }}>
      // Áp dụng kiểu chữ và cỡ chữ đã chọn trước khi vẽ trang để không bị nháy.
      try {
        const root = document.documentElement;
        const font = localStorage.getItem('kieu-chu');
        // Có font chữ mẫu tiểu học thì mặc định hiện chữ viết tay, trừ khi bé đã chọn "Chữ in".
        if (handwritingAvailable && font !== 'in') root.dataset.font = 'viet-tay';
        const size = Number(localStorage.getItem('co-chu'));
        if (size >= 36 && size <= 68) root.style.setProperty('--text-size', size + 'px');
      } catch (_error) {
        // Trình duyệt chặn bộ nhớ: dùng mặc định.
      }
    </script>
  </head>
  <body>
    <div class="page">
      <header class="top-bar">
        <a class="brand" href="/">
          <!-- Mèo cá nhân hoá từ game store; MascotKitten là fallback cho đến khi JS tải xong -->
          <span class="brand-cat" data-brand-cat aria-hidden="true">
            <MascotKitten pose="vui" />
          </span>
          <span data-brand-title>{SITE_TITLE}</span>
        </a>
        <div class="top-bar__right">
          <PwaInstallButton />
          {showToolbar && <ReadingPreferencesToolbar showFontToggle={handwritingAvailable} />}
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="page-footer">
        <p class="family-love">{FAMILY_FOOTER}</p>
        <a href="/cac-bai/">Tất cả bài</a> · <a href="/ghi-nguon/">Ghi nguồn hình ảnh</a>
      </footer>
    </div>
    <ImageZoomDialog />
    <CompanionBuddy context={companionContext} handwritingAvailable={handwritingAvailable} />
  </body>
</html>

<script>
  /**
   * Đồng bộ toàn diện tất cả mèo trên trang theo avatar cá nhân hoá từ game store:
   * 1. Mèo trên thanh thương hiệu (brand logo ở góc trên bên trái).
   * 2. Mọi biểu tượng mèo MascotKitten ([data-mascot-cat]) như mèo vẫy chào trang chủ, mèo gợi ý bài tập...
   * 3. Vòng tròn đại diện nhân vật (.stats-avatar-circle) trên thanh chiến tích.
   * Khi store cập nhật từ bảng cài đặt, tất cả mèo lập tức đổi diện mạo tức thì.
   */
  import {
    renderCatSvgHtml,
    type CatFurColorId,
    type CatAccessoryId,
    type CatPose,
  } from '../components/game/characters/cat-character';
  import { getBrowserGameStore } from '../lib/game/state/game-store';
  import { todayInVietnam } from '../lib/today-lesson-picker';

  const store = getBrowserGameStore(todayInVietnam(), 'Miu');

  function syncAllCats(): void {
    const { avatar } = store.getState();
    const catName = avatar.name?.trim() || 'Miu';
    const furColor = (avatar.furColor as CatFurColorId) || 'vang-cam';
    const accessories = (avatar.accessories as CatAccessoryId[]) ?? [];

    // Cập nhật tên bạn mèo tại mọi vị trí có data-cat-name
    document.querySelectorAll<HTMLElement>('[data-cat-name]').forEach((el) => {
      el.textContent = catName;
    });

    // Cập nhật tiêu đề thương hiệu trên thanh điều hướng
    const brandTitle = document.querySelector<HTMLElement>('[data-brand-title]');
    if (brandTitle) {
      brandTitle.textContent = `Góc học tập của ${catName}`;
    }

    // 1. Mèo thương hiệu ở góc trên bên trái
    const brandCat = document.querySelector<HTMLElement>('[data-brand-cat]');
    if (brandCat) {
      brandCat.innerHTML = renderCatSvgHtml({
        pose: 'vui',
        furColor,
        accessories,
        size: 56,
        label: `Bạn mèo ${catName}`,
      });
    }

    // 2. Mọi mascot mèo trên trang có data-mascot-cat
    const mascotCats = document.querySelectorAll<SVGElement>('[data-mascot-cat]');
    mascotCats.forEach((el) => {
      // Bỏ qua nếu là phần tử con của brandCat đã được vẽ ở bước 1
      if (brandCat && brandCat.contains(el)) return;

      const pose = (el.dataset.pose as CatPose) || 'chao';
      const label = el.getAttribute('aria-label') || el.dataset.label || `Bạn mèo ${avatar.name || 'Miu'}`;
      const className = el.getAttribute('class') || 'mascot';

      const temp = document.createElement('div');
      temp.innerHTML = renderCatSvgHtml({
        pose,
        furColor,
        accessories,
        className,
        label,
        size: 140,
      });

      const newSvg = temp.firstElementChild;
      if (newSvg) {
        newSvg.setAttribute('data-mascot-cat', '');
        newSvg.setAttribute('data-pose', pose);
        newSvg.setAttribute('data-label', label);
        el.replaceWith(newSvg);
      }
    });

    // 3. Vòng tròn avatar trên thanh chiến tích trang chủ
    const statsAvatar = document.querySelector<HTMLElement>('.stats-avatar-circle');
    if (statsAvatar) {
      statsAvatar.innerHTML = renderCatSvgHtml({
        pose: 'vui',
        furColor,
        accessories,
        size: 40,
        label: catName,
      });
    }
  }

  // Chạy ngay khi nạp trang và đăng ký lắng nghe thay đổi từ store
  syncAllCats();
  store.subscribe(syncAllCats);
</script>
