---
/**
 * apps/site/src/pages/the-gioi/tao-nhan-vat.astro
 *
 * Màn tạo & tùy biến nhân vật cho bé (Character Creator):
 * - Hình nhân vật hiển thị bên phải, luôn giữ vị trí khi scroll (sticky) để bé dễ quan sát.
 * - Các tùy chỉnh hiển thị dạng Tab (Tên & Màu lông / Phụ kiện) thao tác nhanh gọn.
 * - Tên bạn mèo tự động đồng bộ sang tất cả các trang.
 * - Bấm "Lên đường! 🚀" để lưu tiến trình và bước vào Thế giới Lớp 2.
 */
import KidPageLayout from '../../layouts/kid-page-layout.astro';
import Hud from '../../components/game/hud.astro';
import AccessoryCategoryPicker from '../../components/game/accessory-category-picker.astro';
import { CAT_FUR_COLORS, CAT_ACCESSORIES } from '../../components/game/characters/cat-character';

const furColors = Object.values(CAT_FUR_COLORS);
const totalAccessories = Object.keys(CAT_ACCESSORIES).length;
---

<KidPageLayout
  title="Tạo nhân vật bạn mèo — Thế giới học tập"
  showToolbar={false}
>
  <Hud
    title="Tạo nhân vật của bé"
    backUrl="/the-gioi/"
    backLabel="Về Cổng thế giới"
    backgroundMusic
    intro="Mình cùng tạo hình bạn mèo nào! Hãy chọn màu lông, phụ kiện thật xinh và đặt cho bạn một cái tên đáng yêu nhé!"
  />

  <main class="creator-main-container">
    <div class="creator-card">
      <div class="creator-header">
        <h1 class="creator-title">✨ Bạn mèo của bé ✨</h1>
        <p class="creator-subtitle">Hãy chọn cho bạn mèo nhỏ cái tên đáng yêu và phong cách thật ngầu nhé!</p>
      </div>

      <div class="creator-content-grid">
        <!-- CỘT TRÁI: Bảng điều khiển phân loại dạng Tab -->
        <div class="creator-options-pane">
          <!-- Thanh Tab chính -->
          <div class="creator-tabs-bar" role="tablist" aria-label="Tùy biến nhân vật">
            <button
              type="button"
              class="creator-tab-btn active"
              data-creator-tab="basic"
              role="tab"
              aria-selected="true"
            >
              <span class="tab-icon">🎨</span>
              <span class="tab-label">Tên & Màu lông</span>
            </button>
            <button
              type="button"
              class="creator-tab-btn"
              data-creator-tab="accessories"
              role="tab"
              aria-selected="false"
            >
              <span class="tab-icon">🎀</span>
              <span class="tab-label">Phụ kiện ({totalAccessories} món)</span>
            </button>
          </div>

          <!-- TAB PANEL 1: Tên & Màu lông -->
          <div class="creator-tab-panel active" data-creator-panel="basic">
            <!-- 1. Đặt tên -->
            <div class="option-group">
              <label class="group-label" for="char-name-input">🏷️ 1. Tên bạn mèo:</label>
              <div class="name-input-wrapper">
                <input
                  type="text"
                  id="char-name-input"
                  class="char-input"
                  maxlength="20"
                  value="Miu"
                  placeholder="Nhập tên bạn mèo..."
                />
                <div class="preset-name-pills">
                  <button type="button" class="name-pill active" data-name="Miu">Miu</button>
                  <button type="button" class="name-pill" data-name="Bơ">Bơ</button>
                  <button type="button" class="name-pill" data-name="Kem">Kem</button>
                  <button type="button" class="name-pill" data-name="Mun">Mun</button>
                  <button type="button" class="name-pill" data-name="Sóc">Sóc</button>
                  <button type="button" class="name-pill" data-name="Bông">Bông</button>
                </div>
              </div>
            </div>

            <!-- 2. Chọn màu lông -->
            <div class="option-group">
              <label class="group-label">🎨 2. Chọn màu lông ({furColors.length} màu):</label>
              <div class="fur-color-grid" id="fur-color-grid">
                {furColors.map((color, index) => (
                  <button
                    type="button"
                    class={`fur-chip ${index === 0 ? 'active' : ''}`}
                    data-fur-id={color.id}
                    data-fur-color={color.fur}
                    title={color.name}
                  >
                    <span class="fur-swatch" style={`background-color: ${color.fur}; border-color: ${color.furDark};`}></span>
                    <span class="fur-name">{color.name}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- TAB PANEL 2: Phụ kiện -->
          <div class="creator-tab-panel" data-creator-panel="accessories">
            <div class="option-group">
              <label class="group-label">🎀 Chọn phụ kiện cho bạn mèo:</label>
              <AccessoryCategoryPicker />
            </div>
          </div>

          <!-- Nút chốt Lưu & Lên đường -->
          <div class="creator-launch-bar">
            <button type="button" class="confirm-launch-btn" id="btn-launch-game">
              🚀 Lên đường vào Thế giới Lớp 2!
            </button>
          </div>
        </div>

        <!-- CỘT PHẢI: Khung xem trước trực quan LUÔN GIỮ VỊ TRÍ KHI SCROLL (Sticky) -->
        <div class="creator-preview-pane">
          <div class="creator-bubble" id="creator-bubble">
            Mến chào bé! Hãy tạo hình cho mình nhé! 🐾
          </div>

          <div class="creator-cat-stage" id="creator-cat-stage">
            <!-- SVG bạn mèo được render bằng script -->
          </div>

          <div class="creator-pose-triggers">
            <button type="button" class="mini-pose-btn active" data-pose="chao">👋 Vẫy tay</button>
            <button type="button" class="mini-pose-btn" data-pose="vui">🎉 Nhảy múa</button>
            <button type="button" class="mini-pose-btn" data-pose="suy-nghi">🤔 Suy nghĩ</button>
            <button type="button" class="mini-pose-btn" data-pose="dung">✨ Đứng</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</KidPageLayout>

<style>
  .creator-main-container {
    display: flex;
    justify-content: center;
    padding: 1.5rem 1rem;
    min-height: calc(100vh - 72px);
    background: linear-gradient(180deg, #fef3c7 0%, #e0f2fe 100%);
  }

  .creator-card {
    width: 100%;
    max-width: 1040px;
    background: #ffffff;
    border: 4px solid #0f172a;
    border-radius: 32px;
    padding: 2rem;
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .creator-header {
    text-align: center;
  }

  .creator-title {
    font-size: 2rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
  }

  .creator-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    margin-top: 0.35rem;
  }

  /* Bố cục 2 cột: Tuỳ chọn bên trái (1fr) - Xem trước bên phải (320px) sticky */
  .creator-content-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
    min-width: 0;
  }

  @media (max-width: 880px) {
    .creator-content-grid {
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column-reverse;
    }
  }

  /* Cột xem trước nhân vật (HIỂN THỊ BÊN PHẢI & STICKY KHI SCROLL) */
  .creator-preview-pane {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem;
    background: #f8fafc;
    border: 3px solid #cbd5e1;
    border-radius: 24px;
    gap: 1.25rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    z-index: 10;
  }

  @media (max-width: 880px) {
    .creator-preview-pane {
      position: sticky;
      top: 0.5rem;
      width: 100%;
      padding: 1rem;
      gap: 0.75rem;
    }
  }

  .creator-bubble {
    padding: 0.6rem 1rem;
    background: #ffffff;
    border: 2px solid #0284c7;
    border-radius: 16px;
    font-weight: 800;
    color: #0369a1;
    text-align: center;
    font-size: 0.95rem;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
    position: relative;
    max-width: 100%;
    word-break: break-word;
  }

  .creator-cat-stage {
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .creator-pose-triggers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .mini-pose-btn {
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 800;
    background: #ffffff;
    border: 2px solid #cbd5e1;
    border-radius: 12px;
    cursor: pointer;
    touch-action: manipulation;
    transition: all 0.15s;
  }

  .mini-pose-btn.active,
  .mini-pose-btn:hover {
    border-color: #0284c7;
    background: #e0f2fe;
    color: #0369a1;
  }

  /* Cột tùy chọn bên trái */
  .creator-options-pane {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  /* Thanh tab phân loại chính */
  .creator-tabs-bar {
    display: flex;
    gap: 0.6rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.6rem;
  }

  .creator-tab-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem 1rem;
    background: #f1f5f9;
    border: 2px solid #cbd5e1;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 900;
    color: #475569;
    cursor: pointer;
    touch-action: manipulation;
    transition: all 0.15s ease;
  }

  .creator-tab-btn:hover {
    background: #e0f2fe;
    border-color: #0284c7;
    color: #0369a1;
  }

  .creator-tab-btn.active {
    background: #0284c7;
    border-color: #0369a1;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
  }

  .tab-icon {
    font-size: 1.15rem;
    line-height: 1;
  }

  /* Panels nội dung của từng Tab */
  .creator-tab-panel {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
    animation: fadeIn 0.2s ease-out;
  }

  .creator-tab-panel.active {
    display: flex;
  }

  .option-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .group-label {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
  }

  .name-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .char-input {
    width: 100%;
    min-height: 52px;
    padding: 0.6rem 1rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    background: #ffffff;
    border: 3px solid #cbd5e1;
    border-radius: 16px;
    outline: none;
    transition: border-color 0.15s;
  }

  .char-input:focus {
    border-color: #0284c7;
    box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.15);
  }

  .preset-name-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .name-pill {
    min-height: 42px;
    padding: 0.4rem 0.85rem;
    font-size: 0.95rem;
    font-weight: 800;
    background: #f1f5f9;
    border: 2px solid #cbd5e1;
    border-radius: 12px;
    cursor: pointer;
    touch-action: manipulation;
    transition: all 0.15s;
  }

  .name-pill.active {
    background: #0284c7;
    color: #ffffff;
    border-color: #0369a1;
  }

  /* Grid màu lông */
  .fur-color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.5rem;
  }

  .fur-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    min-height: 50px;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    cursor: pointer;
    touch-action: manipulation;
    transition: all 0.15s;
  }

  .fur-chip.active {
    border-color: #0284c7;
    background: #f0f9ff;
    box-shadow: 0 0 0 2px #0284c7;
  }

  .fur-swatch {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid;
    flex-shrink: 0;
  }

  .fur-name {
    font-size: 0.82rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.25;
  }

  /* Nút xuất phát */
  .creator-launch-bar {
    margin-top: 0.5rem;
  }

  .confirm-launch-btn {
    width: 100%;
    min-height: 60px;
    font-size: 1.3rem;
    font-weight: 900;
    color: #ffffff;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border: 3px solid #047857;
    border-radius: 20px;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35);
    transition: transform 0.15s, box-shadow 0.15s;
    touch-action: manipulation;
  }

  .confirm-launch-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(16, 185, 129, 0.45);
  }

  .confirm-launch-btn:active {
    transform: translateY(0);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import {
    renderCatSvgHtml,
    type CatPose,
    type CatFurColorId,
    type CatAccessoryId,
    normalizeAccessories,
  } from '../../components/game/characters/cat-character';
  import { bindAccessoryPicker } from '../../lib/game/avatar/accessory-picker';
  import { getBrowserGameStore } from '../../lib/game/state/game-store';
  import { speak, playSfx } from '../../lib/game/media/audio';
  import { todayInVietnam } from '../../lib/today-lesson-picker';

  const today = todayInVietnam();
  const store = getBrowserGameStore(today, 'Miu');
  const initialState = store.getState();

  let currentName = initialState.avatar.name || 'Miu';
  let currentFur: CatFurColorId = (initialState.avatar.furColor as CatFurColorId) || 'vang-cam';
  let currentAccessories: CatAccessoryId[] = normalizeAccessories(initialState.avatar.accessories ?? ['no-hong']);
  let currentPose: CatPose = 'chao';

  const catStage = document.getElementById('creator-cat-stage');
  const nameInput = document.getElementById('char-name-input') as HTMLInputElement | null;
  const bubble = document.getElementById('creator-bubble');

  function renderPreview() {
    if (!catStage) return;
    catStage.innerHTML = renderCatSvgHtml({
      pose: currentPose,
      furColor: currentFur,
      accessories: currentAccessories,
      size: 190,
      label: `Bạn mèo ${currentName}`,
    });
  }

  renderPreview();

  // Tab chuyển đổi: Tên & Màu lông vs Phụ kiện
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-creator-tab]');
  const tabPanels = document.querySelectorAll<HTMLElement>('[data-creator-panel]');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.creatorTab;
      tabButtons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });
      tabPanels.forEach((p) => {
        p.classList.toggle('active', p.dataset.creatorPanel === target);
      });
      playSfx('click');
    });
  });

  // Đổi tư thế xem trước
  const poseButtons = document.querySelectorAll('.mini-pose-btn');
  poseButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      poseButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentPose = btn.getAttribute('data-pose') as CatPose;
      renderPreview();
    });
  });

  // Nhập tên bạn mèo
  nameInput?.addEventListener('input', () => {
    currentName = nameInput.value.trim() || 'Miu';
    if (bubble) bubble.textContent = `Tên mình là ${currentName} nè! Rất vui được học cùng bạn! 🐾`;
  });

  const namePills = document.querySelectorAll('.name-pill');
  namePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      namePills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const val = pill.getAttribute('data-name') || 'Miu';
      currentName = val;
      if (nameInput) nameInput.value = val;
      if (bubble) bubble.textContent = `Tên mình là ${currentName} nè! Rất vui được học cùng bạn! 🐾`;
      playSfx('click');
    });
  });

  // Chọn màu lông
  const furChips = document.querySelectorAll('.fur-chip');
  furChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      furChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      currentFur = (chip.getAttribute('data-fur-id') as CatFurColorId) || 'vang-cam';
      renderPreview();
      playSfx('click');
    });
  });

  // Đồng bộ trạng thái ban đầu từ store
  if (nameInput) nameInput.value = currentName;
  namePills.forEach((p) => {
    p.classList.toggle('active', p.getAttribute('data-name') === currentName);
  });
  furChips.forEach((c) => {
    c.classList.toggle('active', c.getAttribute('data-fur-id') === currentFur);
  });

  // Chọn phụ kiện: mỗi loại 1 món
  const accessoryRoot = document.querySelector('.creator-main-container');
  if (accessoryRoot) {
    bindAccessoryPicker(
      accessoryRoot,
      () => currentAccessories,
      (next) => {
        currentAccessories = next;
        renderPreview();
        playSfx('click');
      },
    );
  }

  // Nút Lưu và Vào Game
  document.getElementById('btn-launch-game')?.addEventListener('click', () => {
    store.update((state) => ({
      ...state,
      avatar: {
        ...state.avatar,
        name: currentName,
        furColor: currentFur,
        accessories: currentAccessories,
        createdOn: today,
      },
    }));
    store.flush();

    playSfx('levelUp');
    speak(`Hoan hô! Bạn mèo ${currentName} đã sẵn sàng bước vào Thế giới Lớp 2!`, { tone: 'cheer' });

    setTimeout(() => {
      window.location.href = '/the-gioi/lop-2/';
    }, 800);
  });
</script>
