<style is:global>
  @import '../../components/game/characters/character-poses.css';

  /* Hoạt hình bước đi di chuyển trên sân khấu */
  .scene-miu.action-di {
    animation: miu-walk-across 5s ease-in-out infinite alternate;
  }
  @keyframes miu-walk-across {
    0% {
      left: 36%;
      transform: translateX(-50%) scaleX(1);
    }
    45% {
      left: 58%;
      transform: translateX(-50%) scaleX(1);
    }
    50% {
      left: 58%;
      transform: translateX(-50%) scaleX(-1); /* Quay đầu lại */
    }
    95% {
      left: 36%;
      transform: translateX(-50%) scaleX(-1);
    }
    100% {
      left: 36%;
      transform: translateX(-50%) scaleX(1);
    }
  }

  /* Hoạt hình bóng đổ khi Miu nhảy */
  .scene-miu.action-nhay .miu-shadow {
    animation: miu-shadow-jump 1.1s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
  }
  @keyframes miu-shadow-jump {
    0%, 100% { transform: scale(1); opacity: 0.25; }
    15% { transform: scale(1.2); opacity: 0.35; }
    45% { transform: scale(0.45); opacity: 0.08; } /* Bóng co nhỏ và mờ đi khi Miu lên cao */
    75% { transform: scale(1.1); opacity: 0.3; }
  }

  /* Hoạt hình bóng đổ khi Miu đi */
  .scene-miu.action-di .miu-shadow {
    animation: miu-shadow-walk 0.6s ease-in-out infinite alternate;
  }
  @keyframes miu-shadow-walk {
