    getPreferredVoice,
    setPreferredTone,
    getPreferredTone,
    VOICE_TONES,
    type VoiceTone,
  } from '../../lib/game/media/audio';

  // Trạng thái nhân vật
  let currentPose: CatPose = 'chao';
  let currentFur: CatFurColorId = 'vang-cam';
  let currentAccessories: CatAccessoryId[] = ['no-hong'];

  // Trạng thái giọng đọc & âm thanh (mặc định giọng Miền Bắc)
  let currentAccent: VietnameseAccent = getPreferredAccent();
  let currentTone: VoiceTone = getPreferredTone();
  let currentRate = VOICE_TONES[currentTone]?.rate ?? 0.82;
  let currentPitch = VOICE_TONES[currentTone]?.pitch ?? 0.98;
  let currentVoiceName = getPreferredVoice('vi') ?? '';

  const slot = document.getElementById('miu-svg-slot');
  const wrapper = document.getElementById('miu-wrapper');
  const rateSlider = document.getElementById('rate-slider') as HTMLInputElement | null;
  const pitchSlider = document.getElementById('pitch-slider') as HTMLInputElement | null;
  const rateDisplay = document.getElementById('rate-display');
  const pitchDisplay = document.getElementById('pitch-display');
  const voiceSelect = document.getElementById('voice-select') as HTMLSelectElement | null;
  const voiceDetectedBadge = document.getElementById('voice-detected-badge');
  const npcContainer = document.getElementById('npc-container');
  const npcSpeechBubble = document.querySelector('.npc-speech-bubble');

  function updateMiu() {
    if (!slot || !wrapper) return;

    // Cập nhật class hành động trên wrapper để áp dụng chuyển động sân khấu (bước đi, nhảy, ngã)
    wrapper.className = `scene-miu action-${currentPose}`;

    // Cập nhật SVG nội dung
    slot.innerHTML = renderCatSvgHtml({
      pose: currentPose,
      furColor: currentFur,
      accessories: currentAccessories,
      size: 160,
      label: `Bé Miu tư thế ${currentPose}`,
    });
  }

  function updateSliderDisplays() {
    if (rateSlider && rateDisplay) {
      rateSlider.value = currentRate.toFixed(2);
      rateDisplay.textContent = `${currentRate.toFixed(2)}x`;
    }
    if (pitchSlider && pitchDisplay) {
      pitchSlider.value = currentPitch.toFixed(2);
      pitchDisplay.textContent = `${currentPitch.toFixed(2)}x`;
    }
  }

  let talkingTimer: number | undefined;
  function setNpcTalking(text: string, durationEstimateMs = 5000) {
    if (npcContainer) npcContainer.classList.add('talking');
    if (npcSpeechBubble) {
      npcSpeechBubble.textContent = text;
      npcSpeechBubble.classList.add('talking');
    }
    window.clearTimeout(talkingTimer);
    talkingTimer = window.setTimeout(() => {
      stopNpcTalking();
    }, durationEstimateMs);
  }

  function stopNpcTalking() {
    if (npcContainer) npcContainer.classList.remove('talking');
    if (npcSpeechBubble) {
      npcSpeechBubble.textContent = 'Chào Miu! Vào Vùng Toán nào! 🦉✨';
      npcSpeechBubble.classList.remove('talking');
    }
  }

  function playSpokenPhrase(text: string, customTone?: VoiceTone) {
    const toneToUse = customTone ?? currentTone;
    speak(text, {
      language: 'vi',
      accent: currentAccent,
      tone: toneToUse,
      rate: currentRate,
      pitch: currentPitch,
      voiceName: currentVoiceName || undefined,
    });
    // Ước chừng thời gian đọc dựa theo số từ và tốc độ để đồng bộ animation
    const words = text.split(/\s+/).length;
    const estDuration = Math.max(2500, Math.round((words / (2.2 * currentRate)) * 1000));
    const bubbleSnippet = text.length > 45 ? text.substring(0, 42) + '...' : text;
    setNpcTalking(bubbleSnippet, estDuration);
  }

  // Khởi tạo slider displays
  updateSliderDisplays();

  // Quét danh sách giọng tiếng Việt khả dụng
  function populateVoiceList() {
    if (!voiceSelect) return;
    const voices = getAvailableVoices('vi', currentAccent);
    voiceSelect.innerHTML = '';

    if (voices.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = 'Giọng mặc định hệ thống';
      voiceSelect.appendChild(opt);
      if (voiceDetectedBadge) {
        voiceDetectedBadge.textContent = 'ℹ️ Chưa tìm thấy giọng tiếng Việt riêng trên máy.';
      }
      return;
    }

    let hasEnhanced = false;
    let autoPickedVoice = '';

    voices.forEach((v, index) => {
      const opt = document.createElement('option');
      opt.value = v.name;
      const score = rateVoiceQuality(v, currentAccent);
      const acc = getVoiceAccent(v);
      const accTag = acc === 'bac' ? '🏛️ Miền Bắc' : acc === 'nam' ? '🌴 Miền Nam' : '🌐 Toàn quốc';

      if (score >= 60) {
        opt.textContent = `⭐ [${accTag}] ${v.name} (Khuyên dùng - Rất truyền cảm)`;
        hasEnhanced = true;
      } else {
        opt.textContent = `[${accTag}] ${v.name}`;
      }

      // Tự động ưu tiên chọn giọng Bắc tốt nhất
      if (!autoPickedVoice && (currentVoiceName ? v.name === currentVoiceName : (acc === 'bac' || index === 0))) {
        opt.selected = true;
        autoPickedVoice = v.name;
      }
      voiceSelect.appendChild(opt);
    });

    if (autoPickedVoice) {
      currentVoiceName = autoPickedVoice;
      setPreferredVoice('vi', currentVoiceName);
    }

    if (voiceDetectedBadge) {
      if (currentAccent === 'bac') {
        const enhancedNote = hasEnhanced ? ' (Chất lượng nâng cao ⭐)' : '';
        voiceDetectedBadge.innerHTML = `🏛️ <strong>Đang ưu tiên Giọng Miền Bắc (Hà Nội):</strong> Tự động chọn <em>${currentVoiceName || 'Linh'}</em>${enhancedNote} chuẩn âm điệu và thanh điệu.`;
        voiceDetectedBadge.style.color = '#15803d';
        voiceDetectedBadge.style.background = '#dcfce7';
      } else if (currentAccent === 'nam') {
        voiceDetectedBadge.innerHTML = `🌴 <strong>Đang chọn Giọng Miền Nam:</strong> <em>${currentVoiceName}</em>`;
        voiceDetectedBadge.style.color = '#0369a1';
        voiceDetectedBadge.style.background = '#e0f2fe';
      } else {
        voiceDetectedBadge.textContent = `🌐 Đang hiển thị tất cả các giọng trên máy (${voices.length} giọng).`;
        voiceDetectedBadge.style.color = '#334155';
        voiceDetectedBadge.style.background = '#f1f5f9';
      }
    }
  }

  populateVoiceList();
  if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
    window.speechSynthesis.onvoiceschanged = populateVoiceList;
    setTimeout(populateVoiceList, 400);
  }

  // Lắng nghe chọn chất giọng vùng miền (Bắc / Nam / Tất cả)
  const accentButtons = document.querySelectorAll('#accent-buttons .accent-btn');
  accentButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      accentButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const acc = btn.getAttribute('data-accent') as VietnameseAccent;
      currentAccent = acc;
      setPreferredAccent(acc);
      currentVoiceName = ''; // reset để auto-pick giọng chuẩn nhất của vùng miền mới
      populateVoiceList();

      if (acc === 'bac') {
        void playAudioClip('/game/audio/sample-north.mp3');
        setNpcTalking('Mến chào bé Miu! Đây là giọng đọc Linh chuẩn Miền Bắc Hà Nội truyền cảm.', 6500);
      } else if (acc === 'nam') {
        void playAudioClip('/game/audio/sample-south.mp3');
        setNpcTalking('Chào bé Miu nha! Đây là giọng đọc Hoài My mang âm điệu Miền Nam ngọt ngào.', 6500);
      } else {
        playSpokenPhrase('Chào bé Miu! Đây là giọng đọc hệ thống.');
      }
    });
  });

  voiceSelect?.addEventListener('change', () => {
    currentVoiceName = voiceSelect.value;
    setPreferredVoice('vi', currentVoiceName);
  });

  document.getElementById('btn-test-selected-voice')?.addEventListener('click', () => {
    const selectedVoice = voiceSelect?.value || currentVoiceName;
    const cleanName = selectedVoice ? selectedVoice.split(' - ')[0] : 'hệ thống';
    playSpokenPhrase(`Mến chào bé Miu! Đây là giọng đọc ${cleanName} trên máy của bé!`);
  });

  // Lắng nghe nút chọn phong cách giọng đọc
  const toneButtons = document.querySelectorAll('#tone-buttons .tone-btn');
  toneButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      toneButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const tone = btn.getAttribute('data-tone') as VoiceTone;
      currentTone = tone;
      setPreferredTone(tone);

      const cfg = VOICE_TONES[tone];
      if (cfg) {
        currentRate = cfg.rate;
        currentPitch = cfg.pitch;
        updateSliderDisplays();
      }

      const samplePhrases: Record<VoiceTone, string> = {
        story: 'Ngày xửa ngày xưa... ở Thung Lũng Con Số diệu kỳ... có một chú mèo nhỏ thông minh tên là Miu.',
        guide: 'Mến chào Miu! Bác Cú Thông Thái sẽ luôn đồng hành và chỉ dẫn từng bước cho bé.',
        cheer: 'Hoan hô bé Miu! Bé đã làm rất xuất sắc, nhận ngay một ngôi sao vàng lấp lánh nhé!',
        calm: 'Không sao đâu bé ngoan... Cứ bình tĩnh thử lại nào, bác Cú luôn ở bên cạnh bé.',
        teacher: 'Chào các em học sinh yêu quý! Hôm nay chúng ta cùng khám phá những phép tính kỳ diệu nhé.',
        normal: 'Xin chào bé Miu! Cùng ta bước vào Cổng Vùng Toán nào.',
      };
      playSpokenPhrase(samplePhrases[tone] ?? 'Xin chào bé Miu!');
    });
  });

  // Lắng nghe thanh trượt Rate & Pitch
  rateSlider?.addEventListener('input', () => {
    currentRate = parseFloat(rateSlider.value);
    if (rateDisplay) rateDisplay.textContent = `${currentRate.toFixed(2)}x`;
  });

  pitchSlider?.addEventListener('input', () => {
    currentPitch = parseFloat(pitchSlider.value);
    if (pitchDisplay) pitchDisplay.textContent = `${currentPitch.toFixed(2)}x`;
  });

  // Lắng nghe nút kể chuyện mẫu
  const storyTexts: Record<string, string> = {
    intro: 'Ngày xửa ngày xưa... ở Thung Lũng Con Số diệu kỳ... có một chú mèo nhỏ thông minh tên là Miu... Hôm nay, Miu mang chiếc ba lô nhỏ xinh, đứng trước cánh cổng Vùng Toán rực rỡ sắc màu... Miu đã sẵn sàng bước vào hành trình phiêu lưu kỳ thú chưa nào?',
    guide: 'Mến chào bé Miu thân yêu... Đừng lo lắng về những bài toán khó nhé... Cứ tự tin từng bước một, bác Cú sẽ luôn bên cạnh chỉ dẫn và nâng đỡ bé trên mọi nẻo đường!',
    reward: 'Ôi tuyệt vời làm sao! Bé Miu đã tìm ra lời giải chính xác rồi... Rương kho báu bừng sáng, và những ngôi sao vàng lấp lánh đang mỉm cười tặng thưởng cho bé kìa!',
    calm: 'Không sao đâu bé ngoan... Cứ bình tĩnh thử lại một lần nữa nhé... Mỗi lần thử là một lần bé thông minh hơn một chút đấy mà! Miu cố lên nào!',
  };

  const northernAudioMap: Record<string, string> = {
    intro: '/game/audio/story-intro.mp3',
    guide: '/game/audio/owl-greeting.mp3',
    reward: '/game/audio/reward-cheer.mp3',
    calm: '/game/audio/calm-encourage.mp3',
  };

  document.querySelectorAll('.story-snippet-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const storyKey = btn.getAttribute('data-story') ?? 'intro';
      const text = storyTexts[storyKey] ?? storyTexts.intro;
      playSfx('magic');

      if (currentAccent === 'bac' && northernAudioMap[storyKey]) {
        void playAudioClip(northernAudioMap[storyKey]);
        const bubbleSnippet = text.length > 45 ? text.substring(0, 42) + '...' : text;
        setNpcTalking(bubbleSnippet, 9500);
      } else {
        playSpokenPhrase(text);
      }
    });
  });

  // Nút dừng đọc
  document.getElementById('btn-stop-speech')?.addEventListener('click', () => {
    stopAudio();
    stopNpcTalking();
  });

  // Bấm vào NPC Cú Thông Thái trên sân khấu
  npcContainer?.addEventListener('click', () => {
    playSfx('magic');
    if (currentAccent === 'bac') {
      void playAudioClip('/game/audio/owl-greeting.mp3');
      setNpcTalking('Mến chào bé Miu thân yêu! Bác Cú đã đợi bé ở Cổng Vùng Toán từ sớm đấy!', 8000);
    } else {
      playSpokenPhrase('Mến chào bé Miu thân yêu... Bác Cú đã đợi bé ở Cổng Vùng Toán từ sớm đấy... Cùng bác bước vào thế giới diệu kỳ của những con số nhé!');
    }
  });

  // Lắng nghe nút chọn tư thế hành động
  const poseButtons = document.querySelectorAll('#pose-buttons .ctrl-btn');
  poseButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      poseButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentPose = btn.getAttribute('data-pose') as CatPose;
      updateMiu();

      // Phát âm thanh tương ứng với hành động để sinh động
      if (currentPose === 'nhay') {
        playSfx('pop');
      } else if (currentPose === 'vui') {
        playSfx('reward');
      } else if (currentPose === 'te') {
        playSfx('wrong');
      } else if (currentPose === 'di') {
        playSfx('pop');
      }
    });
  });

  // Lắng nghe nút chọn màu lông
  const furButtons = document.querySelectorAll('#fur-buttons .ctrl-btn');
  furButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      furButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFur = btn.getAttribute('data-fur') as CatFurColorId;
      updateMiu();
    });
  });

  // Lắng nghe nút chọn phụ kiện (cả 3 nhóm)
  const accButtons = document.querySelectorAll('.acc-btn');
  accButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const accId = btn.getAttribute('data-acc') as CatAccessoryId;
      if (currentAccessories.includes(accId)) {
        currentAccessories = currentAccessories.filter((id) => id !== accId);
        btn.classList.remove('active');
      } else {
        currentAccessories.push(accId);
        btn.classList.add('active');
      }
      updateMiu();
    });
  });

  // Nút âm thanh hiệu ứng
  document.getElementById('btn-sound-magic')?.addEventListener('click', () => {
    playSfx('magic');
  });

  document.getElementById('btn-sound-coin')?.addEventListener('click', () => {
    playSfx('reward');
  });

  document.getElementById('btn-sound-cheer')?.addEventListener('click', () => {
    playSfx('correct');
    const prevPose = currentPose;
    currentPose = 'vui';
    updateMiu();
    setTimeout(() => {
      currentPose = prevPose;
      updateMiu();
    }, 2500);
  });

  document.getElementById('btn-sound-jump')?.addEventListener('click', () => {
    playSfx('pop');
    const prevPose = currentPose;
    currentPose = 'nhay';
    updateMiu();
    setTimeout(() => {
      currentPose = prevPose;
      updateMiu();
    }, 2200);
  });

  document.getElementById('btn-sound-slip')?.addEventListener('click', () => {
    playSfx('wrong');
    const prevPose = currentPose;
    currentPose = 'te';
    updateMiu();
    setTimeout(() => {
      currentPose = prevPose;
      updateMiu();
    }, 2500);
  });
</script>
