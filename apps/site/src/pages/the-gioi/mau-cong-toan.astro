---
/**
 * apps/site/src/pages/the-gioi/mau-cong-toan.astro
 *
 * Cảnh mẫu Cổng vào Vùng Toán để bố mẹ duyệt phong cách mỹ thuật (Phase 2).
 * Tích hợp:
 * - Gạch nền, cổng gỗ, biển báo, cây cối từ Kenney (CC0)
 * - Mèo con Miu vẽ bằng SVG tách lớp với đầy đủ hoạt hình hành động THỰC SỰ
 * - 10 màu lông đa dạng & 16 phụ kiện thuộc 3 nhóm (Đầu, Mặt, Lưng/Cổ)
 * - NPC Người dẫn đường Cú Thông Thái (SVG)
 * - Bảng điều khiển tương tác thời gian thực
 */
import KidPageLayout from '../../layouts/kid-page-layout.astro';
import {
  CAT_FUR_COLORS,
  CAT_ACCESSORIES,
  renderCatSvgHtml,
} from '../../components/game/characters/cat-character';
import { NPC_GUIDES } from '../../components/game/characters/npc-guide';
import { getAssetUrl } from '../../lib/game/media/art-manifest';

const initialMiuSvg = renderCatSvgHtml({
  pose: 'chao',
  furColor: 'vang-cam',
  accessories: ['no-hong'],
  size: 160,
  label: 'Miu đang vẫy chào',
});

const cuThongThaiSvg = NPC_GUIDES['cu-thong-thai'].renderSvg(140);
---

<KidPageLayout title="Cảnh mẫu Cổng Vùng Toán — Bố Mẹ Duyệt Phong Cách" showToolbar={false}>
  <div class="preview-container">
    <header class="preview-header">
      <div class="breadcrumb">
        <a href="/">← Trang chủ</a> / <span>Thế giới học tập</span> / <span>Cảnh mẫu Vùng Toán</span>
      </div>
      <h1 class="preview-title">🎨 Cảnh mẫu: Cổng vào Vùng Toán (Thung Lũng Con Số)</h1>
      <p class="preview-desc">
        Bố mẹ xem và duyệt phong cách đồ hoạ kết hợp: <strong>Kenney CC0</strong> (bối cảnh) + 
        <strong>SVG tự vẽ</strong> (Miu & NPC) + <strong>OpenMoji</strong> (vật phẩm).
        Bấm vào các nút bên dưới để thử <strong>hành động thật</strong> (đi bộ qua lại, nhảy cao, ngã ngồi bệt, ăn mừng...), 
        thay đổi <strong>10 màu lông</strong> và <strong>16 phụ kiện</strong> khác nhau!
      </p>
    </header>

    <!-- Khung cảnh tương tác (Stage) -->
    <div class="stage-wrapper">
      <div class="scene-stage" id="math-stage">
        <!-- Nền trời và mây -->
        <div class="scene-sky">
          <div class="cloud cloud-1"></div>
          <div class="cloud cloud-2"></div>
          <div class="scene-sun"></div>
          <img src={getAssetUrl('openmoji-rainbow')} alt="Cầu vồng" class="scene-rainbow" width="96" height="96" />
        </div>

        <!-- Cây cối hai bên cổng -->
        <div class="scene-tree tree-left">
          <img src={getAssetUrl('tree-cartoon')} alt="Cây bên trái" width="110" height="150" />
        </div>
        <div class="scene-tree tree-right">
          <img src={getAssetUrl('tree-cartoon')} alt="Cây bên phải" width="110" height="150" />
        </div>

        <!-- Cổng gỗ Vùng Toán ở trung tâm -->
        <div class="scene-gate">
          <img src={getAssetUrl('gate-wood')} alt="Cổng gỗ Vùng Toán" width="180" height="162" />
        </div>

        <!-- Biển chỉ đường và khóm hoa -->
        <div class="scene-signpost">
          <img src={getAssetUrl('signpost')} alt="Biển chỉ đường" width="60" height="90" />
        </div>
        <div class="scene-flowers flowers-1">
          <img src={getAssetUrl('flowers')} alt="Khóm hoa" width="48" height="48" />
        </div>
        <div class="scene-flowers flowers-2">
          <img src={getAssetUrl('flowers')} alt="Khóm hoa" width="48" height="48" />
        </div>

        <!-- Rương kho báu và đồng xu vàng -->
        <div class="scene-chest">
          <img src={getAssetUrl('chest-gold')} alt="Rương kho báu" width="64" height="64" />
        </div>
        <div class="scene-coin coin-1">
          <img src={getAssetUrl('coin-star')} alt="Xu sao" width="32" height="32" />
        </div>
        <div class="scene-coin coin-2">
          <img src={getAssetUrl('coin-star')} alt="Xu sao" width="28" height="28" />
        </div>

        <!-- Vật phẩm OpenMoji để bé đếm (kẹo, táo, sách) -->
        <div class="scene-props">
          <img src={getAssetUrl('openmoji-apple')} alt="Quả táo" class="prop prop-apple" width="40" height="40" />
          <img src={getAssetUrl('openmoji-candy')} alt="Kẹo ngọt" class="prop prop-candy" width="40" height="40" />
          <img src={getAssetUrl('openmoji-book')} alt="Quyển sách" class="prop prop-book" width="44" height="44" />
        </div>

        <!-- NPC Cú Thông Thái đứng bên cổng chào đón -->
        <div class="scene-npc" id="npc-container" title="Bấm để nghe Cú chào!">
          <div set:html={cuThongThaiSvg} />
          <div class="npc-speech-bubble">Chào Miu! Vào Vùng Toán nào! 🦉✨</div>
        </div>

        <!-- Mặt đất cỏ và lối đi lát đá Kenney -->
        <div class="scene-ground">
          <div class="ground-grass-layer"></div>
          <div class="ground-path"></div>
        </div>

        <!-- Nhân vật chính Miu (nằm trên lớp mặt đất) -->
        <div class="scene-miu action-chao" id="miu-wrapper">
          <div class="miu-shadow" id="miu-shadow"></div>
          <div id="miu-svg-slot" set:html={initialMiuSvg} />
          <div class="miu-nameplate" id="miu-nameplate">Bé Miu</div>
        </div>
      </div>
    </div>

    <!-- Bảng điều khiển thử nghiệm tương tác cho bố mẹ -->
    <div class="control-panel">
      <h2 class="control-panel-title">🛠️ Bảng điều khiển thử nghiệm Miu (Hành động & Ngoại hình)</h2>

      <!-- Chọn tư thế hành động -->
      <div class="control-group">
        <label class="control-label">
          🎬 Hành động & Tư thế của Miu:
          <span class="control-hint">(bấm để xem chuyển động thật trên sân khấu)</span>
        </label>
        <div class="btn-group" id="pose-buttons">
          <button type="button" class="ctrl-btn active" data-pose="chao">👋 Vẫy chào</button>
          <button type="button" class="ctrl-btn" data-pose="di">🐾 Đi bộ qua lại</button>
          <button type="button" class="ctrl-btn" data-pose="nhay">🦘 Nhảy cao đàn hồi</button>
          <button type="button" class="ctrl-btn" data-pose="vui">🎉 Ăn mừng chiến thắng</button>
          <button type="button" class="ctrl-btn" data-pose="suy-nghi">🤔 Suy nghĩ gợi ý</button>
          <button type="button" class="ctrl-btn" data-pose="te">💥 Trượt ngã ngồi bệt</button>
          <button type="button" class="ctrl-btn" data-pose="buon">🥺 Buồn rũ tai</button>
          <button type="button" class="ctrl-btn" data-pose="dung">🧍 Đứng thở nhẹ</button>
        </div>
      </div>

      <!-- Chọn màu lông -->
      <div class="control-group">
        <label class="control-label">
          🐱 Màu lông (10 bộ sưu tập màu):
          <span class="control-hint">(chọn màu yêu thích cho Miu)</span>
        </label>
        <div class="btn-group" id="fur-buttons">
          {
            Object.values(CAT_FUR_COLORS).map((fur, idx) => (
              <button
                type="button"
                class={`ctrl-btn fur-btn ${idx === 0 ? 'active' : ''}`}
                data-fur={fur.id}
                style={`--fur-color: ${fur.fur};`}
              >
                <span class="color-swatch" style={`background-color: ${fur.fur}; border-color: ${fur.furDark};`}></span>
                {fur.name}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Chọn phụ kiện -->
      <div class="control-group">
        <label class="control-label">
          🎀 Phụ kiện thời trang (16 món — có thể bấm chọn kết hợp nhiều món):
        </label>
        
        <!-- Nhóm Mũ & Đầu -->
        <div class="accessory-subgroup">
          <span class="accessory-subgroup-title">🎩 Mũ & Cài đầu:</span>
          <div class="btn-group" id="acc-head-buttons">
            {
              Object.values(CAT_ACCESSORIES)
                .filter((a) => a.slot === 'head')
                .map((acc) => (
                  <button
                    type="button"
                    class={`ctrl-btn acc-btn ${acc.id === 'no-hong' ? 'active' : ''}`}
                    data-acc={acc.id}
                  >
                    {acc.name}
                  </button>
                ))
            }
          </div>
        </div>

        <!-- Nhóm Mặt & Kính -->
        <div class="accessory-subgroup">
          <span class="accessory-subgroup-title">👓 Mặt & Mắt:</span>
          <div class="btn-group" id="acc-face-buttons">
            {
              Object.values(CAT_ACCESSORIES)
                .filter((a) => a.slot === 'face')
                .map((acc) => (
                  <button type="button" class="ctrl-btn acc-btn" data-acc={acc.id}>
                    {acc.name}
                  </button>
                ))
            }
          </div>
        </div>

        <!-- Nhóm Lưng & Cổ -->
        <div class="accessory-subgroup">
          <span class="accessory-subgroup-title">🎒 Lưng & Cổ:</span>
          <div class="btn-group" id="acc-body-buttons">
            {
              Object.values(CAT_ACCESSORIES)
                .filter((a) => a.slot === 'back' || a.slot === 'neck')
                .map((acc) => (
                  <button type="button" class="ctrl-btn acc-btn" data-acc={acc.id}>
                    {acc.name}
                  </button>
                ))
            }
          </div>
        </div>
      </div>

      <!-- Thử âm thanh & Giọng đọc truyền cảm (Storytelling Studio) -->
      <div class="control-group voice-studio-card">
        <div class="voice-header-flex">
          <div>
            <label class="control-label" style="margin-bottom: 2px;">
              🎙️ Giọng Đọc Truyền Cảm & Kể Chuyện Cho Bé:
            </label>
            <p class="voice-subtitle">
              Tùy biến phong cách kể chuyện cổ tích ấm áp, chọn giọng đọc tốt nhất trên máy và tinh chỉnh nhịp điệu phù hợp với bé Miu.
            </p>
          </div>
          <button type="button" class="stop-speech-btn" id="btn-stop-speech" title="Dừng đọc">
            ⏹️ Dừng đọc
          </button>
        </div>

        <!-- 0. Chọn Vùng miền / Chất giọng -->
        <div class="voice-section-block accent-selector-block">
          <span class="sub-label">🏛️ Chất giọng vùng miền:</span>
          <div class="accent-btn-group" id="accent-buttons">
            <button type="button" class="accent-btn active" data-accent="bac">
              <span class="accent-icon">🏛️</span>
              <div class="accent-text">
                <strong>Giọng Miền Bắc (Hà Nội)</strong>
                <small>Chuẩn âm điệu, tròn vành rõ chữ, truyền cảm (Linh / Nam Minh)</small>
              </div>
            </button>
            <button type="button" class="accent-btn" data-accent="nam">
              <span class="accent-icon">🌴</span>
              <div class="accent-text">
                <strong>Giọng Miền Nam (Sài Gòn)</strong>
                <small>Ngọt ngào, nhẹ nhàng, thân thuộc (Hoài My)</small>
              </div>
            </button>
            <button type="button" class="accent-btn" data-accent="all">
              <span class="accent-icon">🌐</span>
              <div class="accent-text">
                <strong>Tất cả các giọng</strong>
                <small>Hiển thị toàn bộ giọng tiếng Việt trên máy</small>
              </div>
            </button>
          </div>
        </div>

        <!-- 1. Chọn phong cách giọng đọc -->
        <div class="voice-section-block">
          <span class="sub-label">📖 1. Chọn phong cách truyền cảm (bấm để nghe thử ngay):</span>
          <div class="tone-grid" id="tone-buttons">
            <button type="button" class="tone-btn active" data-tone="story">
              <span class="tone-icon">📖</span>
              <div class="tone-info">
                <strong>Kể chuyện cổ tích</strong>
                <span>Trầm ấm, chậm rãi (0.82x), truyền cảm như đọc truyện đêm khuya</span>
              </div>
            </button>
            <button type="button" class="tone-btn" data-tone="guide">
              <span class="tone-icon">🦉</span>
              <div class="tone-info">
                <strong>Bác Cú Thông Thái</strong>
                <span>Từ tốn, ân cần (0.84x), điềm đạm dẫn dắt chỉ lối</span>
              </div>
            </button>
            <button type="button" class="tone-btn" data-tone="cheer">
              <span class="tone-icon">🎉</span>
              <div class="tone-info">
                <strong>Vui tươi khích lệ</strong>
                <span>Hào hứng, rộn ràng (0.92x) khi bé hoàn thành thử thách</span>
              </div>
            </button>
            <button type="button" class="tone-btn" data-tone="calm">
              <span class="tone-icon">💖</span>
              <div class="tone-info">
                <strong>Thủ thỉ dỗ dành</strong>
                <span>Dịu dàng, kiên nhẫn (0.80x) khi bé gặp bài khó hoặc làm chưa đúng</span>
              </div>
            </button>
            <button type="button" class="tone-btn" data-tone="teacher">
              <span class="tone-icon">👩‍🏫</span>
              <div class="tone-info">
                <strong>Cô giáo mẫu mực</strong>
                <span>Rõ ràng, dứt khoát (0.86x), tròn vành rõ chữ chuẩn sư phạm</span>
              </div>
            </button>
          </div>
        </div>

        <!-- 2. Bộ chọn giọng nói thiết bị -->
        <div class="voice-section-block">
          <span class="sub-label">🎧 2. Giọng đọc phát hiện trên máy của gia đình:</span>
          <div class="voice-picker-row">
            <select id="voice-select" class="voice-dropdown">
              <option value="">Đang tìm kiếm giọng tiếng Việt trên máy...</option>
            </select>
            <button type="button" class="ctrl-btn action-btn" id="btn-test-selected-voice">
              ▶️ Nghe giọng này
            </button>
          </div>
          <div id="voice-detected-badge" class="voice-quality-badge">
            Đang quét hệ thống giọng nói...
          </div>
        </div>

        <!-- 3. Thanh tinh chỉnh nhịp điệu -->
        <div class="voice-section-block">
          <span class="sub-label">🎚️ 3. Tinh chỉnh tốc độ & cao độ:</span>
          <div class="sliders-grid">
            <div class="slider-item">
              <div class="slider-header">
                <span>🐢 Tốc độ đọc (Rate):</span>
                <span id="rate-display" class="slider-val-badge">0.82x</span>
              </div>
              <input type="range" id="rate-slider" min="0.70" max="1.15" step="0.02" value="0.82" class="voice-slider" />
              <div class="slider-limits">
                <span>0.70x (Rất chậm)</span>
                <span>0.82x (Kể chuyện chuẩn)</span>
                <span>1.15x (Nhanh)</span>
              </div>
            </div>

            <div class="slider-item">
              <div class="slider-header">
                <span>🎵 Cao độ giọng (Pitch):</span>
                <span id="pitch-display" class="slider-val-badge">0.98x</span>
              </div>
              <input type="range" id="pitch-slider" min="0.80" max="1.20" step="0.02" value="0.98" class="voice-slider" />
              <div class="slider-limits">
                <span>0.80x (Trầm ấm)</span>
                <span>0.98x (Tự nhiên)</span>
                <span>1.20x (Cao/Nhí nhảnh)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Các đoạn kể chuyện mẫu -->
        <div class="voice-section-block">
          <span class="sub-label">📜 4. Nghe thử các đoạn kể chuyện & câu thoại mẫu:</span>
          <div class="story-snippets-list">
            <button type="button" class="story-snippet-btn" data-story="intro">
              <span class="story-icon">🏰</span>
              <div class="story-content">
                <strong>Đoạn truyện mở màn Thung Lũng Con Số</strong>
                <p><em>"Ngày xửa ngày xưa... ở Thung Lũng Con Số diệu kỳ... có một chú mèo nhỏ thông minh tên là Miu... Hôm nay, Miu mang chiếc ba lô nhỏ xinh, đứng trước cánh cổng Vùng Toán rực rỡ sắc màu... Miu đã sẵn sàng bước vào hành trình phiêu lưu kỳ thú chưa nào?"</em></p>
              </div>
              <span class="play-tag">▶️ Nghe</span>
            </button>

            <button type="button" class="story-snippet-btn" data-story="guide">
              <span class="story-icon">🦉</span>
              <div class="story-content">
                <strong>Lời dặn dò ân cần của Bác Cú Thông Thái</strong>
                <p><em>"Mến chào bé Miu thân yêu... Đừng lo lắng về những bài toán khó nhé... Cứ tự tin từng bước một, bác Cú sẽ luôn bên cạnh chỉ dẫn cho bé từng bước một!"</em></p>
              </div>
              <span class="play-tag">▶️ Nghe</span>
            </button>

            <button type="button" class="story-snippet-btn" data-story="reward">
              <span class="story-icon">⭐</span>
              <div class="story-content">
                <strong>Lời khen ngợi ấm áp khi bé giải đúng</strong>
                <p><em>"Ôi tuyệt vời làm sao! Bé Miu đã tìm ra lời giải chính xác rồi... Rương kho báu bừng sáng, và những ngôi sao vàng lấp lánh đang mỉm cười tặng bé kìa!"</em></p>
              </div>
              <span class="play-tag">▶️ Nghe</span>
            </button>

            <button type="button" class="story-snippet-btn" data-story="calm">
              <span class="story-icon">🌸</span>
              <div class="story-content">
                <strong>Lời thủ thỉ động viên khi bé chọn nhầm</strong>
                <p><em>"Không sao đâu bé ngoan... Cứ bình tĩnh thử lại một lần nữa nhé... Mỗi lần thử là một lần bé thông minh hơn một chút đấy mà!"</em></p>
              </div>
              <span class="play-tag">▶️ Nghe</span>
            </button>
          </div>
        </div>

        <!-- 5. Hiệu ứng âm thanh trò chơi -->
        <div class="voice-section-block">
          <span class="sub-label">🔔 5. Hiệu ứng âm thanh trò chơi (Web Audio tổng hợp):</span>
          <div class="btn-group">
            <button type="button" class="ctrl-btn action-btn" id="btn-sound-magic">
              ✨ Tiếng Phép Thuật (Magic Dust)
            </button>
            <button type="button" class="ctrl-btn action-btn" id="btn-sound-coin">
              ⭐ Tiếng Nhận Xu Vàng
            </button>
            <button type="button" class="ctrl-btn action-btn" id="btn-sound-cheer">
              🎊 Tiếng Ăn Mừng
            </button>
            <button type="button" class="ctrl-btn action-btn" id="btn-sound-jump">
              🦘 Tiếng Nhảy Bật
            </button>
            <button type="button" class="ctrl-btn action-btn" id="btn-sound-slip">
              💥 Tiếng Ngã Nhẹ
            </button>
          </div>
        </div>

        <!-- Hướng dẫn về giọng đọc trên iPad và thiết bị -->
        <div class="ipad-tip-card">
          <div class="tip-badge">💡 GIẢI THÍCH VỀ GIỌNG ĐỌC MIỀN BẮC & THIẾT BỊ APPLE</div>
          <p>
            Giọng đọc mặc định mang tên <strong>Linh</strong> trên các thiết bị Apple (iPad, iPhone, Mac) thực chất mang âm hưởng <strong>Miền Nam</strong>.
          </p>
          <p>
            Vì vậy, để bé Miu được học tập với <strong>chuẩn giọng Miền Bắc (Hà Nội)</strong> tròn vành rõ chữ, hệ thống đã trang bị sẵn:
          </p>
          <ol>
            <li><strong>Bản thu âm AI Neural chuẩn Hà Nội (Hoài My & Nam Minh):</strong> Tích hợp sẵn để phát ngay các trích đoạn truyện và lời thoại của Cú Thông Thái.</li>
            <li><strong>Giọng Siri Tiếng Việt (Giọng 1) trên iOS 18.4+:</strong> Nếu máy có Siri tiếng Việt, hệ thống sẽ tự động bắt giọng Bắc.</li>
          </ol>
          <p class="tip-note">
            👉 Bố mẹ hãy bấm vào nút <strong>"🏛️ Giọng Miền Bắc (Hà Nội)"</strong> hoặc các nút <strong>"▶️ Nghe"</strong> ở mục số 4 để nghe ngay chuẩn giọng Hà Nội ấm áp nhé!
          </p>
