---
/**
 * apps/site/src/pages/the-gioi/index.astro
 *
 * Cổng Thế Giới (World Portal):
 * Nơi hiển thị các thế giới học tập theo từng năm học:
 * - Thế giới Lớp 2 (Năm học 2026–2027): Đang mở
 * - Thế giới Lớp 3 (Năm học 2027–2028): Khoá, mở vào năm sau
 * - Các lớp sau: Sắp mở theo từng cấp học
 */
import KidPageLayout from '../../layouts/kid-page-layout.astro';
import Hud from '../../components/game/hud.astro';
import { getAllWorlds } from '../../lib/game/world/world-registry';
import { getWorldOpeningStatus } from '../../lib/game/world/world-calendar';

const worlds = getAllWorlds();

const futureWorlds = [
  { grade: 'lop-3', name: 'Thế giới Lớp 3', schoolYear: '2027–2028', opensOn: '2027-09-05', desc: 'Thử thách toán tư duy nhân chia nhiều chữ số, câu chuyện văn học mở rộng và tiếng Anh giao tiếp nâng cao.' },
  { grade: 'lop-4', name: 'Thế giới Lớp 4', schoolYear: '2028–2029', opensOn: '2028-09-05', desc: 'Khám phá thế giới hình học không gian, phân số và các bài toán chuyển động kỳ thú.' },
  { grade: 'lop-5', name: 'Thế giới Lớp 5', schoolYear: '2029–2030', opensOn: '2029-09-05', desc: 'Chinh phục đỉnh cao tiểu học: số thập phân, tỉ số phần trăm và chuẩn bị bước vào cấp 2.' },
];
---

<KidPageLayout
  title="Cổng Thế Giới — Thế giới học tập của Miu"
  showToolbar={false}
>
  <Hud title="Cổng Thế Giới" backUrl="/" backLabel="Về trang chủ" />

  <main class="portal-main-container">
    <div class="portal-header">
      <h1 class="portal-title">🌌 Cổng Thế Giới Học Tập 🌌</h1>
      <p class="portal-subtitle">Mỗi năm học là một thế giới phiêu lưu kỳ diệu đang chờ đón bé Miu!</p>
    </div>

    <div class="portal-grid">
      <!-- Thế giới hiện có trong hệ thống -->
      {worlds.map((w) => {
        const status = getWorldOpeningStatus(w);
        return (
          <div class={`world-card ${status.isOpen ? 'active-world' : 'locked-world'}`}>
            <div class="world-card-banner">
              <span class="world-grade-badge">🎓 {w.schoolYear}</span>
              <span class="world-status-tag" style={`background-color: ${status.badgeColor};`}>
                {status.statusLabel}
              </span>
            </div>

            <div class="world-card-body">
              <div class="world-icon-circle">
                🏰
              </div>
              <h2 class="world-name">{w.name}</h2>
              <p class="world-desc">{w.description}</p>

              <div class="world-features-pills">
                <span>📐 Vùng Toán</span>
                <span>📖 Vùng Tiếng Việt</span>
                <span>🇬🇧 Vùng Tiếng Anh</span>
                <span>🎪 Sự kiện TIMO</span>
              </div>
            </div>

            <div class="world-card-footer">
              {status.isOpen ? (
                <a href={`/the-gioi/${w.grade}/`} class="enter-world-btn">
                  🚀 Bước vào Thế giới này
                </a>
              ) : (
                <button type="button" class="enter-world-btn locked" disabled>
                  🔒 Mở năm học {w.schoolYear}
                </button>
              )}
            </div>
          </div>
        );
      })}

      <!-- Các thế giới năm học tương lai -->
      {futureWorlds.map((fw) => (
        <div class="world-card locked-world future-world">
          <div class="world-card-banner">
            <span class="world-grade-badge">🎓 {fw.schoolYear}</span>
            <span class="world-status-tag future">Sắp mở</span>
          </div>

          <div class="world-card-body">
            <div class="world-icon-circle locked">
              🔒
            </div>
            <h2 class="world-name">{fw.name}</h2>
            <p class="world-desc">{fw.desc}</p>
          </div>

          <div class="world-card-footer">
            <button type="button" class="enter-world-btn locked" disabled>
              🔒 Mở năm học {fw.schoolYear}
            </button>
          </div>
        </div>
      ))}
    </div>
  </main>
</KidPageLayout>

<style>
  .portal-main-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.25rem 4rem;
    min-height: calc(100vh - 72px);
    background: radial-gradient(circle at 50% 20%, #eff6ff 0%, #f8fafc 100%);
  }

  .portal-header {
    text-align: center;
    max-width: 600px;
    margin-bottom: 2.5rem;
  }

  .portal-title {
    font-size: 2.2rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
  }

  .portal-subtitle {
    font-size: 1.1rem;
    color: #64748b;
    margin-top: 0.5rem;
  }

  .portal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
    width: 100%;
    max-width: 1080px;
  }

  .world-card {
    background: #ffffff;
    border: 3px solid #0f172a;
    border-radius: 28px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .world-card.active-world:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(2, 132, 199, 0.15);
  }

  .world-card.locked-world {
    opacity: 0.85;
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .world-card.future-world {
    opacity: 0.65;
  }

  .world-card-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: #f1f5f9;
    border-bottom: 2px solid #e2e8f0;
  }

  .world-grade-badge {
    font-weight: 800;
    font-size: 0.9rem;
    color: #334155;
  }

  .world-status-tag {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #ffffff;
  }

  .world-status-tag.future {
    background-color: #94a3b8;
  }

  .world-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    gap: 0.75rem;
  }

  .world-icon-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #e0f2fe;
    border: 3px solid #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.8rem;
    margin-bottom: 0.25rem;
  }

  .world-icon-circle.locked {
    background: #f1f5f9;
    border-color: #cbd5e1;
    font-size: 2.2rem;
  }

  .world-name {
    font-size: 1.5rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
  }

  .world-desc {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.45;
    margin: 0;
  }

  .world-features-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .world-features-pills span {
    padding: 0.25rem 0.6rem;
    background: #f1f5f9;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #475569;
  }

  .world-card-footer {
    padding: 1.25rem;
    border-top: 2px solid #e2e8f0;
    background: #ffffff;
  }

  .enter-world-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 56px;
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffffff;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    border: 2px solid #0284c7;
    border-radius: 16px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    touch-action: manipulation;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .enter-world-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
  }

  .enter-world-btn.locked {
    background: #e2e8f0;
    border-color: #cbd5e1;
    color: #94a3b8;
    cursor: not-allowed;
    box-shadow: none;
  }
</style>

<script>
  import { getBrowserGameStore } from '../../lib/game/state/game-store';

  const today = new Date().toISOString().slice(0, 10);
  const store = getBrowserGameStore(today, 'Miu');
  const state = store.getState();

  // Nếu bé chưa tạo nhân vật lần đầu (createdOn === null), chuyển hướng sang màn tạo nhân vật
  if (!state.avatar.createdOn) {
    window.location.replace('/the-gioi/tao-nhan-vat/');
  }
</script>
