---
import KidPageLayout from '../layouts/kid-page-layout.astro';
import MascotKitten from '../components/mascot-kitten.astro';
---

<KidPageLayout title="Không tìm thấy" showToolbar={false} noindex companionContext="khong-tim-thay">
  <div class="mascot-row">
    <MascotKitten pose="goi-y" label="Mèo con đang tìm" />
    <p class="speech-bubble">Mèo con tìm mãi không thấy trang này. Miu mình về trang chủ nhé!</p>
  </div>
  <p class="empty-state">
    <a class="comic-button comic-button--sun" href="/">🏠 Về trang chủ</a>
  </p>
</KidPageLayout>
