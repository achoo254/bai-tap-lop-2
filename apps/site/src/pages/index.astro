---
import KidPageLayout from '../layouts/kid-page-layout.astro';
import MascotKitten from '../components/mascot-kitten.astro';
import { greetingForWorld } from '../lib/family-messages';
import { UNIFORM_SCHEDULE, WEEK_DAYS_ORDER, getUniformForDay } from '../lib/uniform-schedule';
import { TIMETABLE_DATA, SCHOOL_WEEK_DAYS, getScheduleForDay } from '../lib/timetable-schedule';
import { dayOfWeekInVietnam, hourInVietnam, todayInVietnam } from '../lib/today-lesson-picker';

const todayIso = todayInVietnam();
const currentHour = hourInVietnam();
const currentDayOfWeek = dayOfWeekInVietnam();
const todayUniform = getUniformForDay(currentDayOfWeek);
const todaySchedule = getScheduleForDay(currentDayOfWeek) ?? getScheduleForDay(1)!;
---

<KidPageLayout title="Thế giới học tập của Miu" showToolbar={false}>
  <!-- Phần Lời Chào Mèo Con Sinh Động -->
  <div class="mascot-row mascot-row--interactive">
    <MascotKitten pose="chao" label="Mèo con vẫy chào bé Miu" />
    <div class="speech-bubble-container">
      <p class="speech-bubble" data-greeting>{greetingForWorld(currentHour, currentDayOfWeek)}</p>
      <div class="speech-actions">
        <button type="button" class="speech-voice-btn" id="btn-speak-greeting" title="Mèo con đọc lời chào cho bé">
          <span class="voice-icon">🗣️</span>
          <span>Nghe mèo đọc</span>
        </button>
        <button
          type="button"
          class="speech-voice-btn"
          id="btn-sound-toggle"
          title="Bật/tắt nhạc nền và giọng đọc"
          aria-pressed="false"
        >
          <span class="voice-icon" data-sound-icon>🔊</span>
          <span data-sound-label>Đang bật âm thanh</span>
        </button>
      </div>
    </div>
  </div>
  <p class="birthday-banner" data-birthday hidden></p>

  <!-- Thanh Chiến Tích Của Bé Miu (Game State) -->
  <div class="miu-stats-card" id="home-stats-card">
    <div class="stats-avatar-col">
      <div class="stats-avatar-circle">🐱</div>
      <div class="stats-avatar-meta">
        <span class="stats-player-name" id="home-avatar-name">Miu</span>
        <span class="stats-level-pill" id="home-level-badge">Cấp 1</span>
      </div>
    </div>

    <div class="stats-xp-col">
      <div class="stats-xp-meta">
        <span>Kinh nghiệm</span>
        <span id="home-xp-val">0 / 100 XP</span>
      </div>
      <div class="stats-xp-track">
        <div class="stats-xp-fill" id="home-xp-fill" style="width: 0%;"></div>
      </div>
    </div>

    <div class="stats-pills-col">
      <div class="mini-stat-pill coins" title="Số xu vàng đã tích lũy">
        <span>🪙</span>
        <span id="home-coins-val">0</span>
      </div>
      <div class="mini-stat-pill streak" title="Chuỗi ngày học liên tục">
        <span>🔥</span>
        <span id="home-streak-val">1 ngày</span>
      </div>
      <div class="mini-stat-pill stars" title="Số sao hoàn thành xuất sắc">
        <span>⭐</span>
        <span id="home-stars-val">0</span>
      </div>
    </div>
  </div>

  <!-- Cổng Chính: Thế Giới Học Tập Của Miu (Lớp 2) -->
  <div class="world-hero-card">
    <div class="world-hero-header">
      <span class="world-grade-tag">🎓 Năm học 2026–2027 • Lớp 2</span>
      <span class="world-sparkle-tag">✨ Thế giới kỳ diệu</span>
    </div>

    <div class="world-hero-body">
      <div class="world-hero-title-group">
        <div class="world-hero-icon">🌌</div>
        <div>
          <h2 class="world-hero-title">Thế giới học tập của Miu</h2>
          <p class="world-hero-desc">Khám phá các vùng môn học, làm nhiệm vụ vượt thử thách và mở rương kho báu!</p>
        </div>
      </div>

      <a href="/the-gioi/" class="enter-world-cta">
        <span>🚀 Bước vào Thế giới học tập</span>
        <span class="cta-arrow">➜</span>
      </a>
    </div>

    <!-- 4 Cổng nhanh vào từng vùng môn học -->
    <div class="quick-regions-grid">
      <a href="/the-gioi/lop-2/toan/" class="quick-region-card math">
        <span class="region-badge-icon">📐</span>
        <div class="region-meta">
          <span class="region-name">Vùng Toán</span>
          <span class="region-chapter">Thung lũng con số & Thử thách Bác Cú</span>
        </div>
      </a>

      <a href="/the-gioi/lop-2/tieng-viet/" class="quick-region-card vietnamese">
        <span class="region-badge-icon">📖</span>
        <div class="region-meta">
          <span class="region-name">Vùng Tiếng Việt</span>
          <span class="region-chapter">Khu vườn đọc hiểu & Cầu thủ dự bị</span>
        </div>
      </a>

      <a href="/the-gioi/lop-2/tieng-anh/" class="quick-region-card english">
        <span class="region-badge-icon">🇬🇧</span>
        <div class="region-meta">
          <span class="region-name">Vùng Tiếng Anh</span>
          <span class="region-chapter">Vương quốc từ vựng kỳ thú</span>
        </div>
      </a>

      <a href="/the-gioi/lop-2/su-kien/timo/" class="quick-region-card timo">
        <span class="region-badge-icon">🎪</span>
        <div class="region-meta">
          <span class="region-name">Đảo TIMO</span>
          <span class="region-chapter">Thử tài toán tư duy & Đua top</span>
        </div>
      </a>
    </div>
  </div>

  <!-- Phần Góc Học Tập Hằng Ngày: Đồng Phục & Thời Khóa Biểu -->
  <div class="daily-hub-container">
    <!-- 1. Tiện ích Lịch Mặc Đồng Phục -->
    <section class="daily-card uniform-card" id="uniform-section">
      <div class="daily-card-header">
        <div class="card-title-group">
          <span class="card-icon">👗</span>
          <div>
            <h3 class="card-title">Lịch mặc đồng phục của Miu</h3>
            <p class="card-subtitle">Cô giáo và bố mẹ dặn Miu chuẩn bị trang phục</p>
          </div>
        </div>
        <span class="card-badge-today" id="uniform-today-badge">Hôm nay</span>
      </div>

      <!-- 7 Nút chọn các ngày trong tuần -->
      <div class="week-days-selector">
        {WEEK_DAYS_ORDER.map((dayNum) => {
          const u = UNIFORM_SCHEDULE[dayNum];
          const isToday = dayNum === currentDayOfWeek;
          return (
            <button
              type="button"
              class={`day-chip ${isToday ? 'active is-today' : ''}`}
              data-uniform-day={dayNum}
            >
              <span class="day-chip-label">{u.shortName}</span>
              <span class="day-chip-icon">{u.icon}</span>
              {isToday && <span class="chip-star">★</span>}
            </button>
          );
        })}
      </div>

      <!-- Khung hiển thị chi tiết bộ đồ được chọn -->
      <div class="uniform-detail-box" id="uniform-detail-box" style={`background: ${todayUniform.bgLight}; border-color: ${todayUniform.borderColor};`}>
        <div class="uniform-icon-large" id="uniform-detail-icon">{todayUniform.icon}</div>
        <div class="uniform-info-body">
          <div class="uniform-title-row">
            <h4 class="uniform-outfit-title" id="uniform-detail-title" style={`color: ${todayUniform.color};`}>
              {todayUniform.title}
            </h4>
            <span class="uniform-badge-pill" id="uniform-detail-badge">{todayUniform.badge}</span>
          </div>
          <p class="uniform-day-indicator" id="uniform-detail-day">
            Dành cho: <strong>{todayUniform.dayName}</strong>
          </p>
          <p class="uniform-outfit-desc" id="uniform-detail-desc">
            {todayUniform.description}
          </p>
        </div>
      </div>

      <div class="daily-tip-footer">
        <span class="tip-icon">💡</span>
        <span>Bố mẹ dặn Miu: Hãy soạn trang phục và balo từ tối hôm trước để sáng mai đi học thật thảnh thơi nhé!</span>
      </div>
    </section>

    <!-- 2. Tiện ích Thời Khóa Biểu Lớp 2 -->
    <section class="daily-card timetable-card" id="timetable-section">
      <div class="daily-card-header">
        <div class="card-title-group">
          <span class="card-icon">📚</span>
          <div>
            <h3 class="card-title">Thời khóa biểu Lớp 2A6</h3>
            <p class="card-subtitle">Lịch các tiết học buổi sáng và buổi chiều</p>
          </div>
        </div>
        <button type="button" class="btn-toggle-full-table" id="btn-toggle-timetable">
          📋 Cả tuần
        </button>
      </div>

      <!-- Chọn thứ trong tuần đi học (T2 -> T6) -->
      <div class="timetable-days-row">
        {SCHOOL_WEEK_DAYS.map((dayNum) => {
          const sc = TIMETABLE_DATA[dayNum];
          const isSelected = dayNum === (currentDayOfWeek >= 1 && currentDayOfWeek <= 5 ? currentDayOfWeek : 1);
          const isToday = dayNum === currentDayOfWeek;
          return (
            <button
              type="button"
              class={`tt-day-btn ${isSelected ? 'active' : ''} ${isToday ? 'is-today' : ''}`}
              data-tt-day={dayNum}
            >
              <span>{sc.shortName}</span>
              {isToday && <span class="tt-today-dot">•</span>}
            </button>
          );
        })}
      </div>

      <!-- Danh sách tiết học trong ngày được chọn -->
      <div class="timetable-day-view" id="timetable-day-view">
        <div class="session-block morning">
          <div class="session-label">
            <span class="session-icon">☀️</span>
            <span class="session-name">Buổi Sáng (4 tiết)</span>
          </div>
          <div class="periods-list" id="tt-morning-list">
            {todaySchedule.morning.map((p) => (
              <div class="period-item" style={`background: ${p.bg}; border-color: ${p.color};`}>
                <span class="period-num">T{p.period}</span>
                <span class="period-icon">{p.icon}</span>
                <span class="period-subject">{p.subject}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="session-block afternoon">
          <div class="session-label">
            <span class="session-icon">🌤️</span>
            <span class="session-name">Buổi Chiều</span>
          </div>
          <div class="periods-list" id="tt-afternoon-list">
            {todaySchedule.afternoon.map((p) => (
              <div class="period-item" style={`background: ${p.bg}; border-color: ${p.color};`}>
                <span class="period-num">T{p.period}</span>
                <span class="period-icon">{p.icon}</span>
                <span class="period-subject">{p.subject}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Khung bảng toàn bộ tuần (Ẩn/Hiện khi bấm nút "Cả tuần") -->
      <div class="full-timetable-modal" id="full-timetable-panel" hidden>
        <div class="modal-inner-card">
          <div class="modal-header">
            <h4>📅 Toàn bộ Thời khóa biểu Lớp 2A6</h4>
            <button type="button" class="btn-close-modal" id="btn-close-timetable">✕</button>
          </div>
          <div class="table-responsive">
            <table class="comic-table">
              <thead>
                <tr>
                  <th>Buổi</th>
                  <th>Tiết</th>
                  <th>Thứ Hai</th>
                  <th>Thứ Ba</th>
                  <th>Thứ Tư</th>
                  <th>Thứ Năm</th>
                  <th>Thứ Sáu</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td rowspan="4" class="session-col">SÁNG</td>
                  <td class="period-col">1</td>
                  <td>HĐTN</td>
                  <td>Tiếng Việt</td>
                  <td>Tiếng Việt</td>
                  <td>Toán</td>
                  <td>Mĩ thuật</td>
                </tr>
                <tr>
                  <td class="period-col">2</td>
                  <td>Tiếng Việt</td>
                  <td>Tiếng Việt</td>
                  <td>Tiếng Việt</td>
                  <td>GDTC</td>
                  <td>Tiếng Việt</td>
                </tr>
                <tr>
                  <td class="period-col">3</td>
                  <td>Tiếng Việt</td>
                  <td>Toán</td>
                  <td>Toán</td>
                  <td>Tiếng Việt</td>
                  <td>Tiếng Việt</td>
                </tr>
                <tr>
                  <td class="period-col">4</td>
                  <td>GDTC</td>
                  <td>HĐH</td>
                  <td>HĐH</td>
                  <td>Tiếng Việt</td>
                  <td>Toán</td>
                </tr>
                <tr class="noon-break-row">
                  <td colspan="7">🍱 NGHỈ TRƯA & BÁN TRÚ</td>
                </tr>
                <tr>
                  <td rowspan="3" class="session-col">CHIỀU</td>
                  <td class="period-col">1</td>
                  <td>Toán</td>
                  <td>Âm nhạc</td>
                  <td>HĐTN</td>
                  <td>TN và XH</td>
                  <td>HĐGD</td>
                </tr>
                <tr>
                  <td class="period-col">2</td>
                  <td>Đạo đức</td>
                  <td>TN và XH</td>
                  <td>TC Mĩ thuật</td>
                  <td>HĐ Thư viện</td>
                  <td>HĐH</td>
                </tr>
                <tr>
                  <td class="period-col">3</td>
                  <td class="empty-cell">-</td>
                  <td class="empty-cell">-</td>
                  <td class="empty-cell">-</td>
                  <td>HĐH</td>
                  <td>HĐTN</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Lối vào thử giọng & cảnh mẫu dành cho Bố Mẹ -->
  <a class="timo-banner parent-demo-banner" href="/the-gioi/mau-cong-toan/">
    <span class="timo-banner__emoji" aria-hidden="true">🏰</span>
    <span>
      <span class="timo-banner__title">Cảnh mẫu & Thử giọng đọc (Bố mẹ)</span>
      <span class="timo-banner__subtitle">Trải nghiệm phong cách mỹ thuật, tư thế và giọng kể chuyện của NPC</span>
    </span>
  </a>

  <!-- Script dữ liệu JSON thời khóa biểu & đồng phục để tương tác động -->
  <script type="application/json" id="uniform-data-json" set:html={JSON.stringify(UNIFORM_SCHEDULE)} />
  <script type="application/json" id="timetable-data-json" set:html={JSON.stringify(TIMETABLE_DATA)} />
</KidPageLayout>

<style>
  .speech-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* --- Khung Lời Chào Mèo Con --- */
  .mascot-row--interactive {
    position: relative;
    margin-bottom: var(--space-4);
  }
  .speech-bubble-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .speech-voice-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: #ffffff;
    border: 2px solid #0f172a;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
    box-shadow: 0 2px 0 #0f172a;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .speech-voice-btn:hover {
    background: #fef08a;
    transform: translateY(-2px);
    box-shadow: 0 4px 0 #0f172a;
  }
  .speech-voice-btn:active {
    transform: translate(1px, 2px);
    box-shadow: 0 0 0 #0f172a;
  }

  /* --- Thanh Chiến Tích Của Miu (Stats Card) --- */
  .miu-stats-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    background: #ffffff;
    border: 3px solid #0f172a;
    border-radius: 20px;
    box-shadow: 0 4px 0 #0f172a;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .stats-avatar-col {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stats-avatar-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffedd5;
    border: 2px solid #0f172a;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stats-avatar-meta {
    display: flex;
    flex-direction: column;
  }
  .stats-player-name {
    font-weight: 900;
    font-size: 1.05rem;
    color: #0f172a;
    line-height: 1.1;
  }
  .stats-level-pill {
    font-size: 0.75rem;
    font-weight: 800;
    color: #7c2d12;
    background: #fed7aa;
    padding: 1px 8px;
    border-radius: 6px;
    width: fit-content;
    margin-top: 2px;
  }
  .stats-xp-col {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stats-xp-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 800;
    color: #334155;
  }
  .stats-xp-track {
    height: 12px;
    background: #f1f5f9;
    border: 2px solid #0f172a;
    border-radius: 999px;
    overflow: hidden;
  }
  .stats-xp-fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #fbbf24);
    border-radius: 999px;
    transition: width 0.4s ease;
  }
  .stats-pills-col {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mini-stat-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 2px solid #0f172a;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    box-shadow: 0 2px 0 #0f172a;
    background: #ffffff;
  }
  .mini-stat-pill.coins { background: #fef08a; color: #713f12; }
  .mini-stat-pill.streak { background: #fed7aa; color: #7c2d12; }
  .mini-stat-pill.stars { background: #fbcfe8; color: #701a75; }

  /* --- Cổng Chính Thế Giới (Hero Card) --- */
  .world-hero-card {
    background: linear-gradient(135deg, #fef3c7 0%, #e0f2fe 50%, #ede9fe 100%);
    border: 3px solid #0284c7;
    border-radius: 24px;
    box-shadow: 0 6px 0 #0284c7, 0 12px 24px rgba(2, 132, 199, 0.12);
    padding: 22px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .world-hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .world-grade-tag {
    font-size: 0.85rem;
    font-weight: 800;
    color: #075985;
    background: #ffffff;
    border: 2px solid #0284c7;
    border-radius: 999px;
    padding: 3px 12px;
  }
  .world-sparkle-tag {
    font-size: 0.85rem;
    font-weight: 800;
    color: #581c87;
    background: #ffffff;
    border: 2px solid #8b5cf6;
    border-radius: 999px;
    padding: 3px 12px;
  }
  .world-hero-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .world-hero-title-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 260px;
  }
  .world-hero-icon {
    font-size: 3.5rem;
    line-height: 1;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
    animation: gentle-float 3s ease-in-out infinite;
  }
  @keyframes gentle-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .world-hero-title {
    font-size: 1.65rem;
    font-weight: 900;
    color: #0369a1;
    margin: 0 0 4px;
    line-height: 1.2;
  }
  .world-hero-desc {
    font-size: 1.05rem;
    color: #334155;
    margin: 0;
    line-height: 1.35;
  }
  .enter-world-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: #0369a1;
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 900;
    text-decoration: none;
    border: 3px solid #0f172a;
    border-radius: 18px;
    box-shadow: 0 4px 0 #0f172a;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .enter-world-cta:hover {
    background: #0369a1;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #0f172a;
  }
  .enter-world-cta:active {
    transform: translate(2px, 3px);
    box-shadow: 0 1px 0 #0f172a;
  }
  .cta-arrow {
    font-size: 1.3rem;
    transition: transform 0.2s ease;
  }
  .enter-world-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* 4 Cổng Vùng Con */
  .quick-regions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .quick-region-card {
    display: flex;
    align-items: center;
    gap: 12px;
