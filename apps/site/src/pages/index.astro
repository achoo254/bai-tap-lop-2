</style>

<script>
  import { birthdayMessage, greetingForWorld } from '../lib/family-messages';
  import { hourInVietnam, dayOfWeekInVietnam, todayInVietnam } from '../lib/today-lesson-picker';
  import { getBrowserGameStore } from '../lib/game/state/game-store';
  import { levelProgress } from '../lib/game/progression/level-table';
  import { getTotalStars } from '../lib/game/world/unlock-rules';
  import { startBackgroundMusic } from '../lib/game/media/background-music';
  import { isMuted, MUTED_EVENT, setMuted, speak } from '../lib/game/media/audio';
  import { introduceScreen } from '../lib/game/media/screen-intro';
  import type { UniformDay } from '../lib/uniform-schedule';
  import type { DaySchedule } from '../lib/timetable-schedule';

  const today = todayInVietnam();
  const currentHour = hourInVietnam();
  const currentDayOfWeek = dayOfWeekInVietnam();

  // 1. Cập nhật Lời chào Mascot
  const greetingEl = document.querySelector('[data-greeting]');
  if (greetingEl) {
    greetingEl.textContent = greetingForWorld(currentHour, currentDayOfWeek);
  }

  // Trang chủ là màn ngoài bài học: nhạc nền nhẹ nhàng và đọc lời chào khi bé vào
  startBackgroundMusic();
  introduceScreen(greetingEl?.textContent ?? '');

  // 2. Chức năng đọc lời chào bằng giọng nói
  const speakBtn = document.getElementById('btn-speak-greeting');
  speakBtn?.addEventListener('click', () => {
    speak(greetingEl?.textContent || '', { tone: 'guide' });
  });

  // Nút bật/tắt âm thanh (nhạc nền + giọng đọc), dùng chung lựa chọn với nút 🔊 trong thế giới game
  const soundToggle = document.getElementById('btn-sound-toggle');
  function renderSoundToggle() {
    const off = isMuted();
    soundToggle?.setAttribute('aria-pressed', String(off));
    const icon = soundToggle?.querySelector('[data-sound-icon]');
    const label = soundToggle?.querySelector('[data-sound-label]');
    if (icon) icon.textContent = off ? '🔇' : '🔊';
    if (label) label.textContent = off ? 'Đã tắt âm thanh' : 'Đang bật âm thanh';
  }
  renderSoundToggle();
  window.addEventListener(MUTED_EVENT, renderSoundToggle);
  soundToggle?.addEventListener('click', () => {
    setMuted(!isMuted());
    renderSoundToggle();
  });

  // 3. Banner Sinh Nhật
  const birthday = birthdayMessage(today);
  const banner = document.querySelector<HTMLElement>('[data-birthday]');
  if (banner && birthday) {
    banner.textContent = birthday;
    banner.hidden = false;
  }

  // 4. Đồng bộ Thanh Chiến Tích Từ Game Store (localStorage the-gioi:v1)
  const store = getBrowserGameStore(today, 'Miu');
  function updateStats(state: ReturnType<typeof store.getState>) {
    const avatarNameEl = document.getElementById('home-avatar-name');
    const levelBadgeEl = document.getElementById('home-level-badge');
    const xpValEl = document.getElementById('home-xp-val');
    const xpFillEl = document.getElementById('home-xp-fill');
    const coinsEl = document.getElementById('home-coins-val');
    const streakEl = document.getElementById('home-streak-val');
    const starsEl = document.getElementById('home-stars-val');

    if (avatarNameEl) avatarNameEl.textContent = state.avatar.name || 'Miu';
    const { level, ratio, toNext } = levelProgress(state.xp);
    if (levelBadgeEl) levelBadgeEl.textContent = `Cấp ${level}`;
    if (xpValEl) xpValEl.textContent = `${toNext > 0 ? toNext + ' XP nữa' : 'Tối đa'}`;
    if (xpFillEl) xpFillEl.style.width = `${Math.min(100, Math.max(0, Math.round(ratio * 100)))}%`;
    if (coinsEl) coinsEl.textContent = String(state.coins);
    if (streakEl) streakEl.textContent = `${state.streak.current || 1} ngày`;
    if (starsEl) starsEl.textContent = String(getTotalStars(state));
  }
  updateStats(store.getState());
  store.subscribe(updateStats);

  // 5. Tương tác Lịch Mặc Đồng Phục
  const uniformData = JSON.parse(document.getElementById('uniform-data-json')?.textContent || '{}') as Record<number, UniformDay>;
  const dayChips = document.querySelectorAll<HTMLButtonElement>('[data-uniform-day]');
  const detailBox = document.getElementById('uniform-detail-box');
  const detailIcon = document.getElementById('uniform-detail-icon');
  const detailTitle = document.getElementById('uniform-detail-title');
  const detailBadge = document.getElementById('uniform-detail-badge');
  const detailDay = document.getElementById('uniform-detail-day');
  const detailDesc = document.getElementById('uniform-detail-desc');

  dayChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const dayNum = Number(chip.dataset.uniformDay);
      const u = uniformData[dayNum];
      if (!u) return;

      dayChips.forEach((c) => {
        c.classList.remove('active');
        c.setAttribute('aria-selected', 'false');
      });
      chip.classList.add('active');
      chip.setAttribute('aria-selected', 'true');

      if (detailBox) {
        detailBox.style.background = u.bgLight;
        detailBox.style.borderColor = u.borderColor;
      }
      if (detailIcon) detailIcon.textContent = u.icon;
      if (detailTitle) {
        detailTitle.textContent = u.title;
        detailTitle.style.color = u.color;
      }
      if (detailBadge) detailBadge.textContent = u.badge;
      if (detailDay) detailDay.innerHTML = `Dành cho: <strong>${u.dayName}</strong>`;
      if (detailDesc) detailDesc.textContent = u.description;
    });
  });

  // 6. Tương tác Thời Khóa Biểu
  const timetableData = JSON.parse(document.getElementById('timetable-data-json')?.textContent || '{}') as Record<number, DaySchedule>;
  const ttDayBtns = document.querySelectorAll<HTMLButtonElement>('[data-tt-day]');
  const morningList = document.getElementById('tt-morning-list');
  const afternoonList = document.getElementById('tt-afternoon-list');

  function renderDayPeriods(dayNum: number) {
    const sc = timetableData[dayNum];
    if (!sc) return;

    if (morningList) {
      morningList.innerHTML = sc.morning.map((p) => `
        <div class="period-item" style="background: ${p.bg}; border-color: ${p.color};">
          <span class="period-num">T${p.period}</span>
          <span class="period-icon">${p.icon}</span>
          <span class="period-subject">${p.subject}</span>
        </div>
      `).join('');
    }

    if (afternoonList) {
      afternoonList.innerHTML = sc.afternoon.map((p) => `
        <div class="period-item" style="background: ${p.bg}; border-color: ${p.color};">
          <span class="period-num">T${p.period}</span>
          <span class="period-icon">${p.icon}</span>
          <span class="period-subject">${p.subject}</span>
        </div>
      `).join('');
    }
  }

  ttDayBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const dayNum = Number(btn.dataset.ttDay);
      ttDayBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      renderDayPeriods(dayNum);
    });
  });

  // 7. Modal Bảng Toàn Bộ Thời Khóa Biểu
  const modalToggleBtn = document.getElementById('btn-toggle-timetable');
  const modalCloseBtn = document.getElementById('btn-close-timetable');
  const modalPanel = document.getElementById('full-timetable-panel');

  modalToggleBtn?.addEventListener('click', () => {
    if (modalPanel) modalPanel.hidden = false;
  });
  modalCloseBtn?.addEventListener('click', () => {
    if (modalPanel) modalPanel.hidden = true;
  });
  modalPanel?.addEventListener('click', (e) => {
    if (e.target === modalPanel) modalPanel.hidden = true;
  });
</script>
