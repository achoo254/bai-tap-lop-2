---
/**
 * apps/site/src/components/game/event-banner.astro
 *
 * Banner thông báo sự kiện đang diễn ra trong Thế giới học tập:
 * Đặt nổi bật ở đầu bản đồ thế giới, thu hút bé bấm vào trải nghiệm sự kiện.
 */
import EventCountdown from './event-countdown.astro';
import type { EventDefinition } from '../../lib/game/events/event-types';

interface Props {
  event: EventDefinition;
}

const { event } = Astro.props;
const { metadata, schedule } = event;
const { theme } = metadata;
const eventUrl = `/the-gioi/${metadata.grade}/su-kien/${metadata.id}/`;
---

<section
  class="event-banner-card"
  style={`--evt-primary: ${theme.primaryColor}; --evt-secondary: ${theme.secondaryColor}; --evt-bg: ${theme.bgColor}; --evt-border: ${theme.borderColor};`}
>
  <div class="event-banner-inner">
    <div class="event-banner-icon-box">
      <span class="event-main-icon">{theme.icon}</span>
      <span class="event-glow"></span>
    </div>

    <div class="event-banner-content">
      <div class="event-badge-row">
        <span class="event-tag">🎪 SỰ KIỆN ĐẶC BIỆT</span>
        <EventCountdown schedule={schedule} />
      </div>

      <h2 class="event-banner-title">{metadata.name}</h2>
      <p class="event-banner-subtitle">{metadata.subtitle}</p>

      <div class="event-npc-speech">
        <span class="npc-mini-face">🦉</span>
        <span class="speech-bubble">
          <strong>Bác Cú:</strong> "{metadata.description}"
        </span>
      </div>
    </div>

    <div class="event-banner-action">
      <a href={eventUrl} class="enter-event-btn">
        <span>Vào Chơi Ngay</span>
        <span class="btn-arrow">👉</span>
      </a>
    </div>
  </div>
</section>

<style>
  .event-banner-card {
    position: relative;
    width: 100%;
    background: var(--evt-bg, #fffbeb);
    border: 3px solid var(--evt-border, #fde68a);
    border-radius: 24px;
    padding: 1.25rem 1.75rem;
    box-shadow: 0 10px 25px rgba(245, 158, 11, 0.15);
    margin-bottom: 1.75rem;
    overflow: hidden;
  }

  .event-banner-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .event-banner-icon-box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background: #ffffff;
    border-radius: 20px;
    border: 3px solid var(--evt-primary, #f59e0b);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .event-main-icon {
    font-size: 2.5rem;
    z-index: 2;
  }

  .event-banner-content {
    flex: 1;
    min-width: 260px;
  }

  .event-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .event-tag {
    background: var(--evt-primary, #f59e0b);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 8px;
    letter-spacing: 0.03em;
  }

  .event-banner-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 0.2rem 0;
    line-height: 1.2;
  }

  .event-banner-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: #64748b;
    margin: 0 0 0.6rem 0;
  }

  .event-npc-speech {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 2px solid var(--evt-border, #fde68a);
    padding: 0.4rem 0.85rem;
    border-radius: 12px;
    font-size: 0.9rem;
    color: #334155;
  }

  .npc-mini-face {
    font-size: 1.2rem;
  }

  .event-banner-action {
    flex-shrink: 0;
  }

  .enter-event-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, var(--evt-primary, #f59e0b) 0%, var(--evt-secondary, #d97706) 100%);
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 900;
    padding: 0.85rem 1.6rem;
    border-radius: 18px;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(217, 119, 6, 0.35);
    border: 2px solid #ffffff;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
  }

  .enter-event-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 22px rgba(217, 119, 6, 0.45);
  }

  .enter-event-btn:active {
    transform: translateY(1px) scale(0.98);
  }

  .btn-arrow {
    transition: transform 0.2s;
  }

  .enter-event-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .event-banner-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .event-banner-action {
      width: 100%;
    }
    .enter-event-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
