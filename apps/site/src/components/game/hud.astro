---
/**
 * apps/site/src/components/game/hud.astro
 *
 * Thanh trạng thái HUD gắn trên cùng cho mọi màn hình game:
 * - Avatar nhân vật, Cấp độ (Level) & Thanh kinh nghiệm (XP)
 * - Số Xu vàng 🪙 và Chuỗi ngày học tập 🔥
 * - Nút bật/tắt âm thanh 🔊/🔇
 * - Nút điều hướng quay lại bản đồ 🗺️
 */
import '../../styles/game.css';
import '../../components/game/characters/character-poses.css';

interface Props {
  title?: string;
  backUrl?: string;
  backLabel?: string;
  showHearts?: boolean;
  /** Màn ngoài bài học: phát nhạc nền nhẹ nhàng. */
  backgroundMusic?: boolean;
  /** Lời giới thiệu đọc to khi bé vào màn này. */
  intro?: string;
}

const {
  title = 'Thế giới của bé',
  backUrl = '/the-gioi/',
  backLabel = 'Cổng thế giới',
  showHearts = false,
  backgroundMusic = false,
  intro,
} = Astro.props;
---

<div class="game-hud-wrapper" data-background-music={backgroundMusic ? '' : undefined} data-screen-intro={intro}>
  <header class="game-hud" id="game-hud">
    <div class="hud-left">
      <a href="/the-gioi/tao-nhan-vat/" class="hud-avatar-chip" title="Chỉnh sửa nhân vật của bé">
        <div class="hud-avatar-circle" id="hud-avatar-icon">
          🐱
        </div>
        <div class="hud-avatar-info">
          <span class="hud-avatar-name" id="hud-avatar-name" data-cat-name>Miu</span>
          <span class="hud-level-badge" id="hud-level-badge">Cấp 1</span>
        </div>
      </a>

      <div class="hud-xp-container" title="Điểm kinh nghiệm để lên cấp tiếp theo">
        <div class="hud-xp-label">
          <span>XP</span>
          <span id="hud-xp-text">0 / 100</span>
        </div>
        <div class="hud-xp-bar-bg">
          <div class="hud-xp-bar-fill" id="hud-xp-fill" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    <div class="hud-center">
      {showHearts ? (
        <div class="quest-hearts" id="hud-hearts" title="Lượt thử còn lại">
          <span>❤️</span><span>❤️</span><span>❤️</span>
        </div>
      ) : (
        <span class="hud-title-badge">
          {title}
        </span>
      )}
    </div>

  <div class="hud-right">
    <div class="hud-stat-pill coins" title="Số xu vàng đã thu thập">
      <span>🪙</span>
      <span id="hud-coins-val">0</span>
    </div>

    <div class="hud-stat-pill streak" title="Chuỗi ngày phiêu lưu liên tục">
      <span>🔥</span>
      <span id="hud-streak-val">1</span>
    </div>

    <button type="button" class="hud-btn" id="hud-sound-toggle" title="Bật/Tắt âm thanh">
      <span id="hud-sound-icon">🔊</span>
    </button>

    {backUrl && (
      <a href={backUrl} class="hud-btn" title={backLabel} aria-label={backLabel}>
        🗺️
      </a>
    )}
  </div>
</header>
</div>

<script>
  import { getBrowserGameStore } from '../../lib/game/state/game-store';
  import { isMuted, MUTED_EVENT, setMuted } from '../../lib/game/media/audio';
  import { startBackgroundMusic } from '../../lib/game/media/background-music';
  import { introduceScreen } from '../../lib/game/media/screen-intro';
  import { levelProgress } from '../../lib/game/progression/level-table';

  const today = new Date().toISOString().slice(0, 10);
  const store = getBrowserGameStore(today, 'Miu');

  function updateHudElements(state: ReturnType<typeof store.getState>) {
    const avatarNameEl = document.getElementById('hud-avatar-name');
    const levelBadgeEl = document.getElementById('hud-level-badge');
    const xpTextEl = document.getElementById('hud-xp-text');
    const xpFillEl = document.getElementById('hud-xp-fill');
    const coinsEl = document.getElementById('hud-coins-val');
    const streakEl = document.getElementById('hud-streak-val');

    const catName = state.avatar.name?.trim() || 'Miu';
    if (avatarNameEl) avatarNameEl.textContent = catName;
    document.querySelectorAll<HTMLElement>('[data-cat-name]').forEach((el) => {
      el.textContent = catName;
    });

    const { level, ratio, toNext } = levelProgress(state.xp);
    if (levelBadgeEl) levelBadgeEl.textContent = `Cấp ${level}`;

    const pct = Math.min(100, Math.max(0, Math.round(ratio * 100)));
    if (xpTextEl) xpTextEl.textContent = `${toNext > 0 ? toNext + ' XP nữa' : 'Tối đa'}`;
    if (xpFillEl) xpFillEl.style.width = `${pct}%`;

    if (coinsEl) coinsEl.textContent = String(state.coins);
    if (streakEl) streakEl.textContent = String(state.streak.current || 1);
  }

  // Khởi tạo ban đầu và đăng ký lắng nghe thay đổi trạng thái
  updateHudElements(store.getState());
  store.subscribe(updateHudElements);

  // Âm thanh Bật/Tắt
  const soundBtn = document.getElementById('hud-sound-toggle');
  const soundIcon = document.getElementById('hud-sound-icon');

  function updateSoundIcon() {
    if (soundIcon) {
      soundIcon.textContent = isMuted() ? '🔇' : '🔊';
    }
  }

  updateSoundIcon();
  window.addEventListener(MUTED_EVENT, updateSoundIcon);
  soundBtn?.addEventListener('click', () => {
    setMuted(!isMuted());
    updateSoundIcon();
  });

  // Nhạc nền và lời giới thiệu màn (khai báo qua props của HUD)
  const hudWrapper = document.querySelector<HTMLElement>('.game-hud-wrapper');
  if (hudWrapper?.hasAttribute('data-background-music')) startBackgroundMusic();
  const introText = hudWrapper?.dataset.screenIntro;
  if (introText) introduceScreen(introText);
</script>
